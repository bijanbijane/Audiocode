{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:quality-gates": "vitest run src/quality-gate/__tests__/full-pipeline.spec.ts",
    "test:unit": "NODE_OPTIONS='--require=./scripts/test-env.cjs' bash -c 'tsx --test --test-concurrency=2 $(find src packages backend -name \"*.test.ts\" ! -path \"src/engine/longFileStress.test.ts\" ! -path \"src/asr-core/__tests__/Phase1CANativeAsrStreamingIngestion.test.ts\" ! -path \"src/intelligence/SandboxHttpAccessGuard.test.ts\" ! -path \"src/platform/SpeechIntelligenceSandboxHttp.integration.test.ts\" ! -path \"src/platform/__tests__/PlatformControlPlaneGateway.test.ts\" ! -path \"src/platform/__tests__/PlatformControlPlaneHttpRouter.test.ts\" ! -path \"src/platform/__tests__/PlatformWebhookSecurity.test.ts\" | sort)'",
    "test:stress": "tsx --test --test-concurrency=1 src/asr-core/__tests__/Phase1CANativeAsrStreamingIngestion.test.ts src/engine/longFileStress.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report test-results/playwright-report",
    "verify:foundation": "npm run lint && npx vitest run && npm run test:unit && npm run build",
    "dev:api": "tsx scripts/start-api.ts",
    "dev:web": "vite --mode separate --host 0.0.0.0 --port 5173 --strictPort",
    "preview:web": "vite preview --mode separate --host 0.0.0.0 --port 4173 --strictPort",
    "test:separation": "tsx --test src/platform/PlatformApiClient.test.ts src/platform/PlatformApiCompatibilityProxy.test.ts src/platform/LocalExpressLoopbackContract.test.ts backend/src/SeparatedRuntimeRoutingContract.test.ts backend/src/PlatformBackendServices.test.ts",
    "dev:platform-api": "npm run --prefix backend dev",
    "audit:runtime-deps": "node scripts/audit-runtime-dependencies.mjs",
    "audit:express-routes": "node scripts/audit-express-route-ownership.mjs",
    "benchmark:shahab:fleurs": "tsx scripts/benchmark-shahab-fleurs.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
