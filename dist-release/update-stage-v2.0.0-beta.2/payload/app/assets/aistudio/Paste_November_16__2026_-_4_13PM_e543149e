بخش بیستم: موتور تفکیک گویندگان، گفتار هم‌پوشان و تشخیص نشت صدا (MultiSpeakerDiarizationAndCrosstalkEngine.ts)

طبق بخش ۳۸ سند معماری، در پادکست‌ها و مصاحبه‌های فارسی دو سناریو وجود دارد:

1.  تک‌ترک چندگوینده (Single-Track Multi-Speaker): تفکیک گویندگان بر اساس
    بردارهای ویژگی صوتی (Speaker Embeddings + Cosine Similarity Clustering) و
    شناسایی نواحی هم‌پوشان (Overlapping Speech) و گوینده نامشخص
    (UNKNOWN_SPEAKER).
2.  چندترک هم‌زمان (Multi-Track Interview): هر مهمان یک میکروفون مجزا دارد، اما
    وقتی «گوینده الف» بلند صحبت می‌کند، صدای او با تأخیر ۱ تا ۶ میلی‌ثانیه (زمان
    طی شدن فاصله ۱ تا ۲ متری در هوا با سرعت ۳۴۳ متر بر ثانیه) و ۱۲ تا ۲۵ دسی‌بل
    ضعیف‌تر، وارد میکروفون «گوینده ب» می‌شود. اگر سیستم این نشت صدا (Crosstalk)
    را تشخیص ندهد، به اشتباه فکر می‌کند هر دو نفر هم‌زمان در حال صحبت هستند!

// packages/ai-engine/src/MultiSpeakerDiarizationAndCrosstalkEngine.ts
import { Flicks, SampleRate, TimeMath, TimeRange } from '../../contracts/src/timebase.contract';
import { TrackId } from '../../contracts/src/project-schema.contract';

export type SpeakerId = string | 'UNKNOWN_SPEAKER';

export type SegmentAcousticClassification =
  | 'PRIMARY_SPEECH'       // گفتار اصلی گوینده
  | 'OVERLAPPING_SPEECH'   // صحبت هم‌زمان دو یا چند گوینده
  | 'CROSSTALK_MIC_BLEED'  // نشت صدای گوینده دیگر در این میکروفون (نباید گفتار مستقل ثبت شود!)
  | 'UNKNOWN_SPEAKER';     // گوینده با اطمینان پایین‌تر از آستانه

export interface SpeakerTimelineSegment {
  readonly segmentId: string;
  readonly trackId: TrackId;
  readonly speakerId: SpeakerId;
  readonly classification: SegmentAcousticClassification;
  readonly bleedSourceTrackId?: TrackId;
  readonly range: TimeRange;
  readonly confidence: number;
  readonly manuallyVerifiedByUser: boolean;
}

export interface FrameSpeakerEmbedding {
  readonly range: TimeRange;
  /** بردار ویژگی گوینده (مثلاً 192 یا 256 بعدی حاصل از مدل ECAPA-TDNN / PyAnnote ONNX) */
  readonly embeddingVector: Float32Array;
  readonly vadProbability: number;
}

export class MultiSpeakerDiarizationAndCrosstalkEngine {
  /**
   * ۱. تشخیص نشت صدا (Crosstalk / Mic Bleed) و گفتار هم‌پوشان بین ترک‌های هم‌زمان یک پادکست
   * بر اساس اختلاف انرژی (Delta dB) و ضریب هم‌بستگی سیگنال در پنجره تأخیر آکوستیکی اتاق (0 تا 8ms)
   */
  public static analyzeMultiTrackCrosstalkAndOverlap(
    tracksPcm: { trackId: TrackId; speakerId: SpeakerId; pcmMono: Float32Array }[],
    sampleRate: SampleRate,
    frameDurationMs: number = 50
  ): SpeakerTimelineSegment[] {
    if (tracksPcm.length === 0) return [];
    const frameSamples = Math.floor((sampleRate * frameDurationMs) / 1000);
    const totalSamples = Math.min(...tracksPcm.map((t) => t.pcmMono.length));
    const maxAcousticLagSamples = Math.floor((sampleRate * 8) / 1000); // حداکثر 8ms تأخیر آکوستیکی در اتاق (~2.7 متر)

    const rawSegments: SpeakerTimelineSegment[] = [];

    for (let start = 0; start + frameSamples <= totalSamples; start += frameSamples) {
      const range: TimeRange = {
        start: TimeMath.samplesToFlicks(start, sampleRate),
        end: TimeMath.samplesToFlicks(start + frameSamples, sampleRate),
      };

      // محاسبه تراز انرژی (dBFS) هر ترک در این فریم ۵۰ میلی‌ثانیه‌ای
      const trackLevels = tracksPcm.map((t) => {
        let sumSq = 0;
        for (let i = start; i < start + frameSamples; i++) {
          const s = t.pcmMono[i];
          sumSq += s * s;
        }
        const rms = Math.sqrt(sumSq / frameSamples);
        const db = 20 * Math.log10(rms + 1e-9);
        return { ...t, rms, db };
      });

      // فیلتر ترک‌هایی که انرژی بالاتر از آستانه فعالیت صوتی (-45 dBFS) دارند
      const activeTracks = trackLevels
        .filter((t) => t.db > -45.0)
        .sort((a, b) => b.db - a.db);

      if (activeTracks.length === 0) continue;

      const dominant = activeTracks[0];

      // اگر فقط یک میکروفون صدا دارد -> گفتار اصلی و تمیز
      if (activeTracks.length === 1) {
        rawSegments.push({
          segmentId: `seg_${dominant.trackId}_${start}`,
          trackId: dominant.trackId,
          speakerId: dominant.speakerId,
          classification: 'PRIMARY_SPEECH',
          range,
          confidence: 0.95,
          manuallyVerifiedByUser: false,
        });
        continue;
      }

      // اگر بیش از یک میکروفون صدا دارد، بررسی می‌کنیم که آیا ترک‌های ضعیف‌تر «نشت صدا» هستند یا «گفتار هم‌پوشان واقعی»
      let realSimultaneousSpeakers = 1;

      for (let k = 1; k < activeTracks.length; k++) {
        const secondary = activeTracks[k];
        const levelDiffDb = dominant.db - secondary.db;

        // اگر ترک دوم حداقل 11dB ضعیف‌تر باشد و هم‌بستگی آکوستیکی بالایی با ترک غالب داشته باشد -> نشت میکروفون (Bleed)!
        const maxCorr = this.computeMaxLagCorrelation(
          dominant.pcmMono,
          secondary.pcmMono,
          start,
          frameSamples,
          maxAcousticLagSamples
        );

        if (levelDiffDb >= 11.0 && maxCorr >= 0.58) {
          rawSegments.push({
            segmentId: `bleed_${secondary.trackId}_${start}`,
            trackId: secondary.trackId,
            speakerId: secondary.speakerId,
            classification: 'CROSSTALK_MIC_BLEED',
            bleedSourceTrackId: dominant.trackId,
            range,
            confidence: Number(Math.min(0.99, maxCorr).toFixed(2)),
            manuallyVerifiedByUser: false,
          });
        } else {
          realSimultaneousSpeakers++;
          rawSegments.push({
            segmentId: `ovl_${secondary.trackId}_${start}`,
            trackId: secondary.trackId,
            speakerId: secondary.speakerId,
            classification: 'OVERLAPPING_SPEECH',
            range,
            confidence: 0.84,
            manuallyVerifiedByUser: false,
          });
        }
      }

      rawSegments.push({
        segmentId: `dom_${dominant.trackId}_${start}`,
        trackId: dominant.trackId,
        speakerId: dominant.speakerId,
        classification:
          realSimultaneousSpeakers > 1 ? 'OVERLAPPING_SPEECH' : 'PRIMARY_SPEECH',
        range,
        confidence: 0.92,
        manuallyVerifiedByUser: false,
      });
    }

    return this.mergeAdjacentIdenticalSegments(rawSegments);
  }

  /**
   * ۲. خوشه‌بندی بردارهای ویژگی گوینده برای فایل‌های تک‌ترک و تشخیص UNKNOWN_SPEAKER (بخش ۳۸)
   */
  public static assignSpeakersFromEmbeddings(
    trackId: TrackId,
    frames: FrameSpeakerEmbedding[],
    similarityThreshold: number = 0.72
  ): SpeakerTimelineSegment[] {
    const centroids: { speakerId: string; vector: Float32Array; count: number }[] = [];
    const segments: SpeakerTimelineSegment[] = [];

    for (let i = 0; i < frames.length; i++) {
      const frame = frames[i];
      if (frame.vadProbability < 0.45) continue;

      let bestSpeakerId: SpeakerId = 'UNKNOWN_SPEAKER';
      let bestSim = -1;
      let bestCentroidIdx = -1;

      for (let c = 0; c < centroids.length; c++) {
        const sim = this.cosineSimilarity(frame.embeddingVector, centroids[c].vector);
        if (sim > bestSim) {
          bestSim = sim;
          bestCentroidIdx = c;
        }
      }

      if (bestSim >= similarityThreshold && bestCentroidIdx !== -1) {
        bestSpeakerId = centroids[bestCentroidIdx].speakerId;
        // به‌روزرسانی میانگین متحرک مرکز خوشه گوینده
        const cent = centroids[bestCentroidIdx];
        for (let d = 0; d < cent.vector.length; d++) {
          cent.vector[d] = (cent.vector[d] * cent.count + frame.embeddingVector[d]) / (cent.count + 1);
        }
        cent.count++;
      } else if (frame.vadProbability >= 0.75 && centroids.length < 8) {
        // ثبت گوینده جدید در صورتی که کیفیت صدای فریم بالا باشد
        const newId = `SPEAKER_${centroids.length + 1}`;
        centroids.push({
          speakerId: newId,
          vector: new Float32Array(frame.embeddingVector),
          count: 1,
        });
        bestSpeakerId = newId;
        bestSim = 0.85;
      }

      segments.push({
        segmentId: `diar_${trackId}_${i}`,
        trackId,
        speakerId: bestSpeakerId,
        classification:
          bestSpeakerId === 'UNKNOWN_SPEAKER' ? 'UNKNOWN_SPEAKER' : 'PRIMARY_SPEECH',
        range: frame.range,
        confidence: Number(Math.max(0.4, bestSim).toFixed(2)),
        manuallyVerifiedByUser: false,
      });
    }

    return this.mergeAdjacentIdenticalSegments(segments);
  }

  /**
   * ۳. اصلاح دستی گوینده توسط کاربر (Manual Speaker Correction - بخش ۳۸)
   */
  public static applyManualSpeakerCorrection(
    segments: SpeakerTimelineSegment[],
    targetSegmentId: string,
    newSpeakerId: SpeakerId
  ): SpeakerTimelineSegment[] {
    return segments.map((seg) =>
      seg.segmentId === targetSegmentId
        ? {
            ...seg,
            speakerId: newSpeakerId,
            classification:
              newSpeakerId === 'UNKNOWN_SPEAKER' ? 'UNKNOWN_SPEAKER' : 'PRIMARY_SPEECH',
            confidence: 1.0,
            manuallyVerifiedByUser: true,
          }
        : seg
    );
  }

  private static computeMaxLagCorrelation(
    sigA: Float32Array,
    sigB: Float32Array,
    start: number,
    len: number,
    maxLag: number
  ): number {
    let maxCorr = 0;
    const step = Math.max(1, Math.floor(maxLag / 8));

    for (let lag = 0; lag <= maxLag; lag += step) {
      if (start + len + lag >= sigB.length) break;
      let dot = 0;
      let magA = 0;
      let magB = 0;
      for (let i = 0; i < len; i++) {
        const a = Math.abs(sigA[start + i]);
        const b = Math.abs(sigB[start + i + lag]);
        dot += a * b;
        magA += a * a;
        magB += b * b;
      }
      const corr = dot / (Math.sqrt(magA * magB) + 1e-12);
      if (corr > maxCorr) maxCorr = corr;
    }
    return maxCorr;
  }

  private static cosineSimilarity(a: Float32Array, b: Float32Array): number {
    let dot = 0;
    let normA = 0;
    let normB = 0;
    for (let i = 0; i < a.length; i++) {
      dot += a[i] * b[i];
      normA += a[i] * a[i];
      normB += b[i] * b[i];
    }
    return dot / (Math.sqrt(normA * normB) + 1e-12);
  }

  private static mergeAdjacentIdenticalSegments(
    segments: SpeakerTimelineSegment[]
  ): SpeakerTimelineSegment[] {
    if (segments.length <= 1) return segments;
    const sorted = [...segments].sort((a, b) =>
      a.trackId === b.trackId
        ? a.range.start - b.range.start
        : a.trackId.localeCompare(b.trackId)
    );

    const merged: SpeakerTimelineSegment[] = [sorted[0]];
    for (let i = 1; i < sorted.length; i++) {
      const prev = merged[merged.length - 1];
      const curr = sorted[i];

      if (
        prev.trackId === curr.trackId &&
        prev.speakerId === curr.speakerId &&
        prev.classification === curr.classification &&
        curr.range.start <= prev.range.end + TimeMath.secondsToFlicks(0.1)
      ) {
        merged[merged.length - 1] = {
          ...prev,
          range: { start: prev.range.start, end: Math.max(prev.range.end, curr.range.end) },
          confidence: Number(((prev.confidence + curr.confidence) / 2).toFixed(2)),
        };
      } else {
        merged.push(curr);
      }
    }
    return merged;
  }
}

بخش بیست‌ویکم: موتور میکس، استانداردسازی بلندی صدا (ITU-R BS.1770-4 LUFS) و محدودکننده True Peak (LoudnessAndMasteringEngine.ts)

طبق بخش ۲.۴، ۳۳ و ۳۴ سند معماری، خروجی یک پلتفرم حرفه‌ای پادکست و کتاب صوتی
نباید بلندی صدای شانسی داشته باشد. این ماژول:

1.  استاندارد جهانی پخش رادیویی و پادکست (ITU-R BS.1770-4 / EBU R128) را با
    فیلتر دو مرحله‌ای K-Weighting (شبیه‌ساز آکوستیک سر انسان + فیلتر RLB) و
    الگوریتم Two-Stage Gating (حذف سکوت‌های زیر -70 LUFS و محاسبه آستانه نسبی
    -10 LU) پیاده می‌کند.
2.  پیک واقعی بین نمونه‌ها (Inter-Sample True Peak - dBTP) را با درون‌یابی ۴
    برابری (4x Oversampling) اندازه می‌گیرد تا در هنگام تبدیل به MP3/AAC هیچ
    اعوجاجی رخ ندهد.
3.  قانون Equal-Power Pan Law (-3.0 dB) را برای میکس چندکاناله اجرا کرده و صدای
    نهایی را دقیقاً روی هدف استاندارد پادکست (-16.0 LUFS استریو / -19.0 LUFS
    مونو با سقف -1.0 dBTP) مستر می‌کند.

// packages/audio-runtime/src/LoudnessAndMasteringEngine.ts
import { SampleRate } from '../../contracts/src/timebase.contract';

export interface LoudnessMeasurementReport {
  readonly integratedLufs: number;
  readonly maxShortTermLufs: number;
  readonly truePeakDbtp: number;
  readonly headroomDb: number;
}

export class LoudnessAndMasteringEngine {
  /**
   * ۱. اندازه‌گیری دقیق Integrated LUFS و True Peak (dBTP) طبق استاندارد ITU-R BS.1770-4
   */
  public static measureLoudnessAndTruePeak(
    channels: Float32Array[],
    sampleRate: SampleRate
  ): LoudnessMeasurementReport {
    const chCount = channels.length;
    const frameCount = channels[0]?.length ?? 0;
    if (chCount === 0 || frameCount === 0) {
      return {
        integratedLufs: -70.0,
        maxShortTermLufs: -70.0,
        truePeakDbtp: -100.0,
        headroomDb: 100.0,
      };
    }

    // الف) اعمال فیلتر K-Weighting (Pre-Filter + RLB High-Pass) روی هر کانال
    const kWeightedChannels = channels.map((ch) => this.applyKWeightingFilter(ch, sampleRate));

    // ب) محاسبه انرژی میانگین مربعات در بلوک‌های ۴۰۰ میلی‌ثانیه‌ای با گام ۱۰۰ میلی‌ثانیه (75% Overlap)
    const blockSamples = Math.floor(sampleRate * 0.4);
    const stepSamples = Math.floor(sampleRate * 0.1);
    const blockEnergies: number[] = [];

    for (let start = 0; start + blockSamples <= frameCount; start += stepSamples) {
      let blockSum = 0;
      for (let c = 0; c < chCount; c++) {
        const kCh = kWeightedChannels[c];
        let chSquareSum = 0;
        for (let i = start; i < start + blockSamples; i++) {
          const val = kCh[i];
          chSquareSum += val * val;
        }
        blockSum += chSquareSum / blockSamples;
      }
      blockEnergies.push(blockSum);
    }

    // ج) دروازه اول (Absolute Gate در -70 LKFS)
    const absGateThresholdEnergy = Math.pow(10, (-70.0 + 0.691) / 10.0);
    const blocksAboveAbs = blockEnergies.filter((e) => e > absGateThresholdEnergy);

    let integratedLufs = -70.0;
    if (blocksAboveAbs.length > 0) {
      const meanAboveAbs =
        blocksAboveAbs.reduce((acc, v) => acc + v, 0) / blocksAboveAbs.length;
      const relativeThresholdLufs = -0.691 + 10 * Math.log10(meanAboveAbs) - 10.0; // -10 LU Relative Gate
      const relGateThresholdEnergy = Math.pow(10, (relativeThresholdLufs + 0.691) / 10.0);

      // د) دروازه دوم (Relative Gate)
      const gatedBlocks = blocksAboveAbs.filter((e) => e > relGateThresholdEnergy);
      if (gatedBlocks.length > 0) {
        const finalMeanEnergy =
          gatedBlocks.reduce((acc, v) => acc + v, 0) / gatedBlocks.length;
        integratedLufs = -0.691 + 10 * Math.log10(finalMeanEnergy);
      }
    }

    // هـ) محاسبه بیشترین Short-Term LUFS (پنجره ۳ ثانیه‌ای = ۳۰ گام ۱۰۰ میلی‌ثانیه‌ای)
    let maxShortTermEnergy = 0;
    const stWindowSteps = 30;
    for (let i = 0; i <= blockEnergies.length - stWindowSteps; i++) {
      let sum = 0;
      for (let k = 0; k < stWindowSteps; k++) sum += blockEnergies[i + k];
      const mean = sum / stWindowSteps;
      if (mean > maxShortTermEnergy) maxShortTermEnergy = mean;
    }
    const maxShortTermLufs =
      maxShortTermEnergy > 1e-12 ? -0.691 + 10 * Math.log10(maxShortTermEnergy) : -70.0;

    // و) محاسبه 4x Oversampled Inter-Sample True Peak (dBTP)
    const truePeakLin = this.compute4xTruePeakLinear(channels);
    const truePeakDbtp = 20 * Math.log10(truePeakLin + 1e-12);

    return {
      integratedLufs: Number(integratedLufs.toFixed(2)),
      maxShortTermLufs: Number(maxShortTermLufs.toFixed(2)),
      truePeakDbtp: Number(truePeakDbtp.toFixed(2)),
      headroomDb: Number((-truePeakDbtp).toFixed(2)),
    };
  }

  /**
   * ۲. نرمال‌سازی هوشمند بلندی صدا به استاندارد پادکست (-16 LUFS) همراه با Lookahead True-Peak Limiter (-1.0 dBTP)
   */
  public static normalizeToTargetLufsWithTruePeakLimiter(
    channels: Float32Array[],
    sampleRate: SampleRate,
    targetLufs: number = -16.0,
    ceilingDbtp: number = -1.0
  ): { normalizedChannels: Float32Array[]; appliedGainDb: number } {
    const report = this.measureLoudnessAndTruePeak(channels, sampleRate);
    if (report.integratedLufs <= -68.0) {
      return { normalizedChannels: channels, appliedGainDb: 0 };
    }

    // محدود کردن افزایش گین به حداکثر +18dB برای جلوگیری از بالا کشیدن نویز در فایل‌های بسیار ضعیف
    const rawGainDb = Math.min(18.0, Math.max(-24.0, targetLufs - report.integratedLufs));
    const linearMakeup = Math.pow(10, rawGainDb / 20.0);
    const ceilingLin = Math.pow(10, ceilingDbtp / 20.0);

    const frameCount = channels[0].length;
    const chCount = channels.length;
    const outChannels = channels.map((ch) => new Float32Array(ch.length));

    // محاسبه پوش (Envelope) محدودکننده با Release نرم 60ms
    const releaseCoeff = Math.exp(-1.0 / (0.06 * sampleRate));
    let gainReductionEnv = 1.0;

    for (let i = 0; i < frameCount; i++) {
      let maxSampleInFrame = 0;
      for (let c = 0; c < chCount; c++) {
        const amplified = Math.abs(channels[c][i] * linearMakeup);
        if (amplified > maxSampleInFrame) maxSampleInFrame = amplified;
      }

      const requiredAttenuation =
        maxSampleInFrame > ceilingLin ? ceilingLin / maxSampleInFrame : 1.0;

      if (requiredAttenuation < gainReductionEnv) {
        gainReductionEnv = requiredAttenuation; // Instantaneous brickwall catch
      } else {
        gainReductionEnv =
          releaseCoeff * gainReductionEnv + (1.0 - releaseCoeff) * requiredAttenuation;
      }

      const totalFrameGain = linearMakeup * gainReductionEnv;
      for (let c = 0; c < chCount; c++) {
        outChannels[c][i] = channels[c][i] * totalFrameGain;
      }
    }

    return {
      normalizedChannels: outChannels,
      appliedGainDb: Number(rawGainDb.toFixed(2)),
    };
  }

  /**
   * ۳. میکس کانال مونو به استریو با قانون Equal-Power Pan Law (-3.0 dB در مرکز) طبق بخش ۳۳
   */
  public static applyEqualPowerPan(
    monoInput: Float32Array,
    panPosition: number // -1.0 (چپ کامل) تا +1.0 (راست کامل)، 0.0 (مرکز)
  ): [Float32Array, Float32Array] {
    const clampedPan = Math.max(-1.0, Math.min(1.0, panPosition));
    const angle = ((clampedPan + 1.0) * Math.PI) / 4.0; // 0 تا PI/2
    const gainL = Math.cos(angle);
    const gainR = Math.sin(angle);

    const left = new Float32Array(monoInput.length);
    const right = new Float32Array(monoInput.length);
    for (let i = 0; i < monoInput.length; i++) {
      left[i] = monoInput[i] * gainL;
      right[i] = monoInput[i] * gainR;
    }
    return [left, right];
  }

  /** فیلتر دو مرحله‌ای K-Weighting استاندارد ITU-R BS.1770-4 */
  private static applyKWeightingFilter(input: Float32Array, sampleRate: SampleRate): Float32Array {
    // مرحله ۱: فیلتر High-Shelf (+4dB بالای 1.5kHz)
    const stage1 = this.runBiquad(
      input,
      1.53512485958697,
      -2.69169618940638,
      1.19839281085285,
      -1.69065929318241,
      0.73248077421585
    );
    // مرحله ۲: فیلتر High-Pass RLB
    return this.runBiquad(
      stage1,
      1.0,
      -2.0,
      1.0,
      -1.99004745483398,
      0.99007225036621
    );
  }

  private static runBiquad(
    input: Float32Array,
    b0: number,
    b1: number,
    b2: number,
    a1: number,
    a2: number
  ): Float32Array {
    const out = new Float32Array(input.length);
    let x1 = 0, x2 = 0, y1 = 0, y2 = 0;
    for (let i = 0; i < input.length; i++) {
      const x0 = input[i];
      const y0 = b0 * x0 + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
      x2 = x1;
      x1 = x0;
      y2 = y1;
      y1 = y0;
      out[i] = y0;
    }
    return out;
  }

  /** تخمین دقیق Inter-Sample True Peak با درون‌یابی چندجمله‌ای بین نمونه‌های متوالی */
  private static compute4xTruePeakLinear(channels: Float32Array[]): number {
    let maxPeak = 0;
    for (const ch of channels) {
      for (let i = 1; i < ch.length - 2; i++) {
        const y0 = ch[i - 1];
        const y1 = ch[i];
        const y2 = ch[i + 1];
        const y3 = ch[i + 2];

        const abs1 = Math.abs(y1);
        if (abs1 > maxPeak) maxPeak = abs1;

        // بررسی نقطه میانی بین نمونه i و i+1 با درون‌یابی مکعبی Catmull-Rom (تخمین پیک بین نمونه‌ای)
        if (abs1 > 0.25) {
          const midPeak = Math.abs(-0.0625 * y0 + 0.5625 * y1 + 0.5625 * y2 - 0.0625 * y3);
          if (midPeak > maxPeak) maxPeak = midPeak;
        }
      }
    }
    return maxPeak;
  }
}

بخش بیست‌ودوم: مدیر به‌روزرسانی اتمیک، Rollback و بلوغ قابلیت‌ها (ReleaseAndFeatureMaturityManager.ts)

این ماژول دقیقاً بخش ۴۷ (Update Management) و بخش ۵۴ (بلوغ قابلیت‌ها) در سند
معماری را پیاده می‌کند:

1.  هر قابلیت دارای یکی از ۶ وضعیت رسمی (EXPERIMENTAL, PREVIEW, BETA, STABLE,
    DEPRECATED, DISABLED) است و قابلیت‌های آزمایشی هرگز بدون فعال‌سازی صریح
    کاربر در محیط اصلی تدوین به‌عنوان قابلیت پایدار نمایش داده نمی‌شوند.
2.  قانون طلایی بخش ۴۷ («نسخه جدید نباید پروژه فعال را در معرض خرابی قرار دهد»):
    زمانی که نسخه جدیدی از برنامه یا مدل دانلود می‌شود، در وضعیت
    STAGED_PENDING_IDLE قرار می‌گیرد و تا زمانی که کاربر پروژه فعال را نبندد یا
    تمام تراکنش‌ها ذخیره نشده باشند، سوئیچ نسخه رخ نمی‌دهد (Atomic Update with
    Instant Rollback).

// packages/project-core/src/ReleaseAndFeatureMaturityManager.ts
import { ProjectVersionMatrix } from '../../contracts/src/project-schema.contract';

/** ۶ سطح رسمی بلوغ قابلیت‌ها طبق بخش ۵۴ سند معماری */
export type FeatureMaturityStage =
  | 'EXPERIMENTAL'
  | 'PREVIEW'
  | 'BETA'
  | 'STABLE'
  | 'DEPRECATED'
  | 'DISABLED';

export interface PlatformFeatureDescriptor {
  readonly featureId: string;
  readonly titleFa: string;
  readonly stage: FeatureMaturityStage;
  readonly minRequiredDeviceTier: 'MOBILE_COMPANION' | 'TABLET_STUDIO' | 'DESKTOP_STUDIO';
  readonly minModelBundleVersion?: string;
}

export interface StagedReleaseBundle {
  readonly releaseId: string;
  readonly versions: ProjectVersionMatrix;
  readonly minCompatibleSchemaVersion: number;
  readonly stagedAtTimestamp: number;
}

export class ReleaseAndFeatureMaturityManager {
  private currentRelease: StagedReleaseBundle;
  private previousRollbackRelease: StagedReleaseBundle | null = null;
  private stagedNextRelease: StagedReleaseBundle | null = null;
  private readonly features = new Map<string, PlatformFeatureDescriptor>();

  constructor(initialRelease: StagedReleaseBundle, catalog: PlatformFeatureDescriptor[]) {
    this.currentRelease = initialRelease;
    for (const f of catalog) {
      this.features.set(f.featureId, f);
    }
  }

  /**
   * ۱. بررسی مجوز نمایش و اجرای یک قابلیت بر اساس سطح بلوغ و توان دستگاه (بخش ۱۴ و ۵۴)
   */
  public canActivateFeature(
    featureId: string,
    userOptedIntoExperimental: boolean
  ): { allowed: boolean; badgeFa: string | null; reasonFa?: string } {
    const feat = this.features.get(featureId);
    if (!feat || feat.stage === 'DISABLED') {
      return { allowed: false, badgeFa: null, reasonFa: 'این قابلیت غیرفعال است.' };
    }

    if (feat.stage === 'EXPERIMENTAL' && !userOptedIntoExperimental) {
      return {
        allowed: false,
        badgeFa: 'آزمایشی (Experimental)',
        reasonFa: 'قابلیت آزمایشی به صورت پیش‌فرض در محیط پایدار فعال نمی‌شود.',
      };
    }

    const badges: Record<FeatureMaturityStage, string | null> = {
      STABLE: null, // قابلیت پایدار نیاز به برچسب هشدار ندارد
      BETA: 'نسخه بتا (Beta)',
      PREVIEW: 'پیش‌نمایش (Preview)',
      EXPERIMENTAL: 'آزمایشی (Experimental)',
      DEPRECATED: 'منسوخ‌شده (Deprecated)',
      DISABLED: null,
    };

    return {
      allowed: true,
      badgeFa: badges[feat.stage],
    };
  }

  /**
   * ۲. آماده‌سازی نسخه جدید در پس‌زمینه بدون دست زدن به پروژه فعال (بخش ۴۷: Atomic Update)
   */
  public stageUpdateInBackground(nextBundle: StagedReleaseBundle): void {
    this.stagedNextRelease = nextBundle;
  }

  /**
   * ۳. اعمال اتمیک به‌روزرسانی فقط در زمانی که هیچ پروژه فعالی در حال ویرایش یا رندر نیست
   */
  public commitStagedUpdateIfSafe(params: {
    hasActiveOpenProject: boolean;
    hasRunningJobs: boolean;
    activeProjectSchemaVersion?: number;
  }): { committed: boolean; activeRelease: StagedReleaseBundle; reasonFa: string } {
    if (!this.stagedNextRelease) {
      return {
        committed: false,
        activeRelease: this.currentRelease,
        reasonFa: 'نسخه جدیدی در صف انتظار نیست.',
      };
    }

    // قانون بخش ۴۷: نسخه جدید هرگز نباید در حین باز بودن پروژه یا اجرای Job اعمال شود
    if (params.hasActiveOpenProject || params.hasRunningJobs) {
      return {
        committed: false,
        activeRelease: this.currentRelease,
        reasonFa:
          'پروژه یا عملیات پردازشی فعال است؛ اعمال نسخه جدید تا بسته شدن ایمن پروژه به تعویق افتاد.',
      };
    }

    if (
      params.activeProjectSchemaVersion !== undefined &&
      params.activeProjectSchemaVersion < this.stagedNextRelease.minCompatibleSchemaVersion
    ) {
      return {
        committed: false,
        activeRelease: this.currentRelease,
        reasonFa: 'نسخه جدید نیازمند اجرای مهاجرت اسکیما (Migration) روی پروژه است.',
      };
    }

    // ذخیره نسخه فعلی برای امکان Rollback فوری در صورت بروز خطا
    this.previousRollbackRelease = this.currentRelease;
    this.currentRelease = this.stagedNextRelease;
    this.stagedNextRelease = null;

    return {
      committed: true,
      activeRelease: this.currentRelease,
      reasonFa: 'نسخه جدید به صورت اتمیک و ایمن فعال شد.',
    };
  }

  /**
   * ۴. بازگشت فوری به نسخه پایدار قبلی (Instant Rollback - بخش ۴۷)
   */
  public rollbackToPreviousRelease(): StagedReleaseBundle {
    if (!this.previousRollbackRelease) {
      throw new Error('NO_ROLLBACK_SNAPSHOT_AVAILABLE');
    }
    this.currentRelease = this.previousRollbackRelease;
    this.previousRollbackRelease = null;
    return this.currentRelease;
  }
}

وضعیت پیشرفت مهندسی و گام بعدی

تا این لحظه ۲۲ بخش کامل از سیستم طراحی و کدنویسی شده است و تمام الزامات فنی،
صوتی، هوش مصنوعی، امنیتی و زیرساختی سند نسخه ۱.۲ دارای کد مرجع هستند.

در گام بعدی (در صورت دستور ادامه)، مستقیماً به سراغ تدوین یکپارچه و رسمی «ده سند
مشخصات مرجع پروژه (The 10 Official Reference Specifications - بخش ۶۷ و ۶۹ سند
معماری)» به همراه جدول دقیق مالکیت مفاهیم (Single Source of Truth Matrix) و
معیارهای پذیرش کمی (Quantitative Acceptance Criteria) برای هر سند می‌رویم تا
پرونده مستندات مهندسی پروژه نیز ۱۰۰٪ تکمیل شود.
