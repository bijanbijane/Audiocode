بخش صدو‌چهلم: کارخانه یکپارچه‌سازی کل سرویس‌های Backend (BackendApplicationFactory.ts)

تا این بخش، سرویس‌های مختلف Backend (PlatformBackendServices،
BackendAuthAndPaymentService، BackendLicenseAndModelRevocationService،
BackendModelCanaryRolloutService، BackendExternalApiProxyService،
EnterpriseApiKeyAndQuotaManager، SingleFlightReadThroughCache و
BackendMetricsExporter) را به صورت ماژولار نوشتیم.

کلاس زیر تمامی این اجزا را در یک ساختار استاندارد Dependency-Injected Fastify
App به هم متصل می‌کند تا هم در server.ts (تولید) و هم در تست‌های یکپارچگی Vitest
به سادگی با یک فراخوانی ساخته شود:

// apps/platform-backend/src/BackendApplicationFactory.ts
import Fastify, { FastifyInstance, FastifyReply, FastifyRequest } from 'fastify';
import type { PgPoolLike } from './PlatformBackendServices';
import { PlatformBackendServices } from './PlatformBackendServices';
import { BackendAuthAndPaymentService } from './BackendAuthAndPaymentService';
import { BackendLicenseAndModelRevocationService } from './BackendLicenseAndModelRevocationService';
import { BackendModelCanaryRolloutService } from './rollout/BackendModelCanaryRolloutService';
import { BackendExternalApiProxyService } from './gateway/BackendExternalApiProxyService';
import { EnterpriseApiKeyAndQuotaManager } from './auth/EnterpriseApiKeyAndQuotaManager';
import {
  BackendMetricsExporter,
  SingleFlightReadThroughCache,
} from './cache/BackendReadThroughCacheAndMetrics';
import { AdvisoryLockCoordinator } from './ops/BackendJobOutboxAndAdvisoryLockService';

export interface BackendAppFactoryConfig {
  readonly ed25519PrivateKeyPem: string;
  readonly ed25519PublicKeyPem: string;
  readonly keyId: string;
  readonly paymentWebhookHmacSecret: string;
  readonly adminApiSecretKey: string;
  readonly modelStorageRootDir: string;
  readonly cdnBaseUrl: string;
  readonly enableServerSideAsrInference: boolean;
  readonly enableRequestLogging?: boolean;
}

export interface BuiltBackendApplication {
  readonly fastify: FastifyInstance;
  readonly sharedCache: SingleFlightReadThroughCache;
  readonly enterpriseKeys: EnterpriseApiKeyAndQuotaManager;
  readonly externalGateway: BackendExternalApiProxyService;
  readonly advisoryLocks: AdvisoryLockCoordinator;
}

export function buildBackendApplication(
  db: PgPoolLike,
  config: BackendAppFactoryConfig
): BuiltBackendApplication {
  const fastify = Fastify({
    logger: config.enableRequestLogging
      ? {
          level: 'info',
          redact: [
            'req.headers.authorization',
            'req.headers["x-gateway-signature"]',
            'req.headers["x-admin-api-key"]',
            'req.headers["x-enterprise-api-key"]',
          ],
        }
      : false,
    trustProxy: true,
  });

  const sharedCache = new SingleFlightReadThroughCache();
  const metricsExporter = new BackendMetricsExporter(sharedCache);
  metricsExporter.registerHooksAndEndpoint(fastify);

  const authAndPayment = new BackendAuthAndPaymentService(db, {
    ed25519PrivateKeyPem: config.ed25519PrivateKeyPem,
    ed25519PublicKeyPem: config.ed25519PublicKeyPem,
    paymentWebhookHmacSecret: config.paymentWebhookHmacSecret,
  });

  const platformServices = new PlatformBackendServices(db, {
    modelStorageRootDir: config.modelStorageRootDir,
    ed25519PrivateKeyPem: config.ed25519PrivateKeyPem,
    keyId: config.keyId,
    cdnBaseUrl: config.cdnBaseUrl,
    enableServerSideAsrInference: config.enableServerSideAsrInference,
  });

  const revocationService = new BackendLicenseAndModelRevocationService(
    db,
    config.adminApiSecretKey
  );
  const canaryRolloutService = new BackendModelCanaryRolloutService(
    db,
    sharedCache,
    config.adminApiSecretKey
  );
  const externalGateway = new BackendExternalApiProxyService(db);
  const enterpriseKeys = new EnterpriseApiKeyAndQuotaManager(db);
  const advisoryLocks = new AdvisoryLockCoordinator(db);

  // ۱. میدل‌ور امنیتی محافظت از مسیرهای خصوصی کاربر با EdDSA JWT
  fastify.addHook('preHandler', async (request: FastifyRequest, reply: FastifyReply) => {
    const requiresUserJwt =
      request.url.startsWith('/api/v1/license/lease') ||
      request.url.startsWith('/api/v1/license/enforce-device-seat');

    if (!requiresUserJwt) return;

    const authHeader = request.headers.authorization;
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
      return reply.status(401).send({ error: 'MISSING_BEARER_TOKEN' });
    }
    try {
      const claims = authAndPayment.verifyEdDsaJwt(authHeader.slice(7).trim());
      (request as FastifyRequest & { authenticatedUserId?: string }).authenticatedUserId =
        claims.sub;
    } catch {
      return reply.status(401).send({ error: 'INVALID_OR_EXPIRED_TOKEN' });
    }
  });

  // ۲. ثبت تمام سرویس‌های هسته Backend
  authAndPayment.registerRoutes(fastify);
  platformServices.registerAllRoutes(fastify);
  revocationService.registerRoutes(fastify);
  canaryRolloutService.registerRoutes(fastify);
  externalGateway.registerRoutes(fastify);

  // ۳. اندپوینت ساخت کلید سازمانی (Admin Only)
  fastify.post<{
    Headers: { 'x-admin-api-key': string };
    Body: {
      organizationId: string;
      scopes: ('MODELS_READ' | 'EXTERNAL_GATEWAY' | 'CLOUD_ASR_ENTERPRISE')[];
      monthlyAudioSecondsLimit: number;
    };
  }>('/api/v1/admin/enterprise-keys', async (request, reply) => {
    if (request.headers['x-admin-api-key'] !== config.adminApiSecretKey) {
      return reply.status(401).send({ error: 'ADMIN_UNAUTHORIZED' });
    }
    const created = await enterpriseKeys.issueNewEnterpriseApiKey(request.body);
    return reply.status(201).send(created);
  });

  // ۴. اندپوینت‌های سلامت سرور برای Docker / Kubernetes
  fastify.get('/healthz', async () => ({
    status: 'alive',
    uptimeSec: Math.round(process.uptime()),
  }));

  fastify.get('/readyz', async (_request, reply) => {
    try {
      await db.query('SELECT 1');
      return reply.send({ status: 'ready', postgres: 'connected' });
    } catch {
      return reply.status(503).send({ status: 'not_ready', postgres: 'disconnected' });
    }
  });

  return {
    fastify,
    sharedCache,
    enterpriseKeys,
    externalGateway,
    advisoryLocks,
  };
}

بخش صد‌و‌چهل‌ویکم: موتور استخراج عبارت‌های کلیدی فارسی (RAKE) و شاخص‌گذاری موضوعی (PersianTopicAndKeywordIndexer.ts)

پس از اینکه موتور ASR متن یک سخنرانی، جلسه سازمانی یا پادکست فارسی را استخراج
کرد، سازمان‌ها و تولیدکنندگان محتوا نیاز دارند به صورت ۱۰۰٪ محلی و بدون ارسال
متن به مدل‌های ابری، عبارت‌های کلیدی چندکلمه‌ای (Multi-Word Keyphrases) مانند
«امنیت زنجیره تأمین»، «پردازش محلی صوت» یا «شاخص رضایت مشتری» را از دل رونوشت
استخراج کنند.

این ماژول الگوریتم کلاسیک RAKE (Rapid Automatic Keyword Extraction) را با
جداکننده‌های دستوری فارسی (حروف اضافه، افعال ربطی «است، بود، شد»، علائم نگارشی و
پیوندهای مکث بلند آکوستیکی بالای ۶۰۰ میلی‌ثانیه!) تطبیق داده و با معیار
\frac{\text{degree}(w)}{\text{freq}(w)} دقیق‌ترین عبارت‌های چندکلمه‌ای فارسی را
امتیازدهی می‌کند:

// packages/ai-engine/src/asr/PersianTopicAndKeywordIndexer.ts
import { TimedPersianToken } from '../PersianTextNormalizer';
import { TimeMath } from '../../../contracts/src/timebase.contract';

export interface ExtractedPersianKeyphrase {
  readonly phraseFa: string;
  readonly rakeScore: number;
  readonly occurrenceCount: number;
  readonly firstAppearanceSeconds: number;
}

export class PersianTopicAndKeywordIndexer {
  /** واژگان ایست (Stopwords) و افعال کمکی که مرز عبارت‌های کلیدی فارسی را تشکیل می‌دهند */
  private static readonly PERSIAN_PHRASE_DELIMITERS = new Set([
    'و', 'یا', 'در', 'به', 'از', 'با', 'برای', 'تا', 'که', 'را', 'بر', 'بی',
    'این', 'آن', 'اینها', 'آنها', 'این‌ها', 'آن‌ها', 'هم', 'نیز', 'ولی', 'اما',
    'چون', 'زیرا', 'اگر', 'وقتی', 'هنگامی', 'بنابراین', 'لذا', 'پس', 'حتی', 'فقط',
    'است', 'هست', 'نیست', 'بود', 'شد', 'می‌شود', 'می‌کند', 'دارد', 'دارند', 'داریم',
    'کرد', 'کرده', 'شده', 'باید', 'نباید', 'بتواند', 'خیلی', 'بسیار', 'یک', 'دو', 'سه',
    'من', 'ما', 'تو', 'شما', 'او', 'ایشان', 'خود', 'همه', 'هر', 'هیچ', 'چه', 'چرا',
  ]);

  /**
   * استخراج عبارت‌های کلیدی چندکلمه‌ای فارسی از روی توکن‌های زمان‌بندی‌شده خروجی ASR با الگوریتم RAKE
   */
  public static extractPersianKeyphrases(
    tokens: TimedPersianToken[],
    topK: number = 8,
    maxWordsPerPhrase: number = 4
  ): ExtractedPersianKeyphrase[] {
    if (tokens.length === 0) return [];

    // ۱. استخراج عبارت‌های نامزد (Candidate Keyphrases) بر اساس واژگان ایست، علائم نگارشی و مکث‌های آکوستیکی > 600ms
    const candidatePhrases: { words: string[]; startSec: number }[] = [];
    let currentWords: string[] = [];
    let currentStartSec = 0;

    const flushPhrase = () => {
      if (currentWords.length >= 1 && currentWords.length <= maxWordsPerPhrase) {
        candidatePhrases.push({
          words: [...currentWords],
          startSec: currentStartSec,
        });
      } else if (currentWords.length > maxWordsPerPhrase) {
        // تقسیم عبارت‌های خیلی طولانی به پنجره‌های مجاز
        for (let i = 0; i < currentWords.length; i += maxWordsPerPhrase) {
          candidatePhrases.push({
            words: currentWords.slice(i, i + maxWordsPerPhrase),
            startSec: currentStartSec,
          });
        }
      }
      currentWords = [];
    };

    for (let i = 0; i < tokens.length; i++) {
      const tok = tokens[i];
      const prev = i > 0 ? tokens[i - 1] : null;
      const gapMs = prev
        ? TimeMath.flicksToSeconds(tok.range.start - prev.range.end) * 1000
        : 0;

      if (gapMs > 600 && currentWords.length > 0) {
        flushPhrase();
      }

      const rawDisplay = tok.displayText;
      const hasTrailingPunct = /[،؛.!؟:]$/.test(rawDisplay);
      const cleanNorm = tok.normalizedText.replace(/[،؛.!؟:«»"()\-]/g, '').trim();

      if (
        cleanNorm.length < 2 ||
        this.PERSIAN_PHRASE_DELIMITERS.has(cleanNorm)
      ) {
        flushPhrase();
        continue;
      }

      if (currentWords.length === 0) {
        currentStartSec = TimeMath.flicksToSeconds(tok.range.start);
      }
      currentWords.push(cleanNorm);

      if (hasTrailingPunct) {
        flushPhrase();
      }
    }
    flushPhrase();

    if (candidatePhrases.length === 0) return [];

    // ۲. محاسبه بسامد (freq) و درجه هم‌رخدادی (degree) برای تک‌تک واژگان محتوایی در الگوریتم RAKE
    const wordFreq = new Map<string, number>();
    const wordDegree = new Map<string, number>();

    for (const cand of candidatePhrases) {
      const deg = cand.words.length;
      for (const w of cand.words) {
        wordFreq.set(w, (wordFreq.get(w) ?? 0) + 1);
        wordDegree.set(w, (wordDegree.get(w) ?? 0) + deg);
      }
    }

    const wordScore = new Map<string, number>();
    for (const [w, freq] of wordFreq.entries()) {
      const deg = wordDegree.get(w) ?? freq;
      wordScore.set(w, deg / freq);
    }

    // ۳. تجمیع امتیاز کل هر عبارت یکتا و مرتب‌سازی نزولی
    const phraseStats = new Map<
      string,
      { score: number; count: number; firstSec: number; wordLen: number }
    >();

    for (const cand of candidatePhrases) {
      const phraseStr = cand.words.join(' ');
      let sumScore = 0;
      for (const w of cand.words) {
        sumScore += wordScore.get(w) ?? 0;
      }
      // اولویت ملایم به عبارت‌های ۲ و ۳ کلمه‌ای نسبت به تک‌کلمه‌ها
      const multiWordBonus = cand.words.length >= 2 ? 1.15 : 1.0;
      const finalScore = sumScore * multiWordBonus;

      const existing = phraseStats.get(phraseStr);
      if (!existing) {
        phraseStats.set(phraseStr, {
          score: finalScore,
          count: 1,
          firstSec: cand.startSec,
          wordLen: cand.words.length,
        });
      } else {
        existing.count++;
      }
    }

    return Array.from(phraseStats.entries())
      .map(([phraseFa, st]) => ({
        phraseFa,
        rakeScore: Number((st.score * (1 + Math.log2(st.count) * 0.25)).toFixed(2)),
        occurrenceCount: st.count,
        firstAppearanceSeconds: Number(st.firstSec.toFixed(2)),
      }))
      .sort((a, b) => b.rakeScore - a.rakeScore)
      .slice(0, topK);
  }
}

