// apps/platform-backend/__tests__/FullBackendIntegration.spec.ts
import { describe, it, expect } from 'vitest';
import crypto from 'node:crypto';
import os from 'node:os';
import { buildBackendApplication } from '../src/BackendApplicationFactory';
import { PgPoolLike } from '../src/PlatformBackendServices';
import { PersianTopicAndKeywordIndexer } from '../../../packages/ai-engine/src/asr/PersianTopicAndKeywordIndexer';
import { PersianTextNormalizer } from '../../../packages/ai-engine/src/PersianTextNormalizer';
import { TimeMath } from '../../../packages/contracts/src/timebase.contract';

describe('Full Backend Factory Integration & Persian RAKE Keyphrase Suite', () => {
  it('1. Full BackendApplicationFactory wires Auth, JWT Guards, Enterprise Keys, Canary, Healthz & Prometheus Metrics cleanly', async () => {
    const { publicKey, privateKey } = crypto.generateKeyPairSync('ed25519');
    const privPem = privateKey.export({ type: 'pkcs8', format: 'pem' }).toString();
    const pubPem = publicKey.export({ type: 'spki', format: 'pem' }).toString();
    const adminKey = 'admin_factory_secret';

    const mockDb: PgPoolLike = {
      async query(sql) {
        if (sql === 'SELECT 1') return { rows: [{ '?column?': 1 }] as any, rowCount: 1 };
        if (sql.includes('INSERT INTO enterprise_api_keys')) {
          return { rows: [{ key_id: 'ent_key_99' }] as any, rowCount: 1 };
        }
        if (sql.includes('FROM ai_models_catalog')) {
          return {
            rows: [{ model_id: 'fastconformer-fa', version: '1.2.0', release_status: 'ACTIVE' }] as any,
            rowCount: 1,
          };
        }
        return { rows: [], rowCount: 0 };
      },
    };

    const app = buildBackendApplication(mockDb, {
      ed25519PrivateKeyPem: privPem,
      ed25519PublicKeyPem: pubPem,
      keyId: 'k_prod',
      paymentWebhookHmacSecret: 'pay_sec',
      adminApiSecretKey: adminKey,
      modelStorageRootDir: os.tmpdir(),
      cdnBaseUrl: 'https://cdn.local',
      enableServerSideAsrInference: false,
    });

    // ۱. بررسی سلامت سرور
    const readyRes = await app.fastify.inject({ method: 'GET', url: '/readyz' });
    expect(readyRes.statusCode).toBe(200);
    expect(readyRes.json().postgres).toBe('connected');

    // ۲. بررسی مسدود شدن درخواست بدون JWT به اندپوینت لایسنس
    const unauthLicense = await app.fastify.inject({
      method: 'POST',
      url: '/api/v1/license/lease',
      payload: { userId: 'u1', deviceFingerprintHash: 'h1' },
    });
    expect(unauthLicense.statusCode).toBe(401);

    // ۳. بررسی صدور کلید سازمانی از مسیر ادمین
    const keyRes = await app.fastify.inject({
      method: 'POST',
      url: '/api/v1/admin/enterprise-keys',
      headers: { 'x-admin-api-key': adminKey },
      payload: {
        organizationId: 'org_media_1',
        scopes: ['MODELS_READ'],
        monthlyAudioSecondsLimit: 7200,
      },
    });
    expect(keyRes.statusCode).toBe(201);
    expect(keyRes.json().plaintextApiKeyOnce.startsWith('paudio_live_')).toBe(true);

    // ۴. بررسی خروجی متریک‌های Prometheus
    const metricsRes = await app.fastify.inject({ method: 'GET', url: '/metrics' });
    expect(metricsRes.statusCode).toBe(200);
    expect(metricsRes.body).toContain('paudio_backend_http_requests_total');
  });

  it('2. PersianTopicAndKeywordIndexer extracts multi-word Persian keyphrases with timestamps using RAKE', () => {
    const words = [
      'در', 'این', 'جلسه', 'درباره', 'پردازش', 'محلی', 'صوت', 'و', 'امنیت', 'زنجیره', 'تامین',
      'صحبت', 'می‌کنیم', '.', 'هدف', 'ما', 'بهبود', 'پردازش', 'محلی', 'صوت', 'در', 'مرورگر', 'است', '.'
    ];

    const tokens = PersianTextNormalizer.buildThreeLayerTranscript(
      words.map((w, idx) => ({
        id: `tk_${idx}`,
        text: w,
        range: {
          start: TimeMath.secondsToFlicks(idx * 0.35),
          end: TimeMath.secondsToFlicks(idx * 0.35 + 0.3),
        },
        confidence: 0.95,
      }))
    );

    const keyphrases = PersianTopicAndKeywordIndexer.extractPersianKeyphrases(tokens, 5);
    const extractedStrings = keyphrases.map((k) => k.phraseFa);

    expect(extractedStrings).toContain('پردازش محلی صوت');
    expect(extractedStrings).toContain('امنیت زنجیره تامین');
    expect(keyphrases[0].occurrenceCount).toBeGreaterThanOrEqual(1);
  });
});

جمع‌بندی جامع کل بخش‌های Backend و موتور اصلی تشخیص گفتار (تا بخش ۱۴۲)

با تکمیل بخش‌های ۹۸ تا ۱۴۲ که به صورت خالص بر هسته موتور تشخیص گفتار فارسی و
سرویس‌های Backend متمرکز بودند، اکنون سیستم شما دارای یک موتور ASR و زیرساخت
سروری کاملاً صنعتی، مستقل از محیط اجرا و آزمون‌پذیر است:

1.  معماری سه‌گانه استنتاج عصبی روی ONNX Runtime (WebGPU / WASM / Node CPU /
    CUDA):
      - FastConformer-CTC (با دیکدر CTC Prefix Beam Search + مدل زبان باینری
        فشرده PLM1 + Context-Biasing Trie + زیرکلمه‌های SentencePiece)
      - Whisper Seq2Seq (با KV-Cache خطی، پرامپت تطبیقی v2/v3-turbo، Beam Search
        چندپرتویی + Temperature Fallback + محافظ فشرده‌سازی LZ77)
      - RNN-Transducer & TDT (با شبکه پیش‌بین LSTM و پرش زمانی Duration Skip)
2.  تشخیص زنده، VAD و تفکیک گویندگان:
      - Silero VAD v5 (تانسورهای دقیق [1, 576] و [2, 1, 128])، Causal
        Cache-Aware Streaming FastConformer، LocalAgreement-2 + Draft Horizon،
        پایانه‌سنج نحوی-آکوستیکی فارسی
        (PersianSyntacticAcousticEndpointDetector)، و تفکیک گویندگان ECAPA-TDNN
        + AHC همراه با هم‌ترازگر دقیق مرز کلمات
        (SpeakerTurnBoundaryWordAligner).
3.  پالایش پس‌ازتشخیص و بهینه‌سازی زبان فارسی:
      - هم‌ترازی دوگذره Whisper + CTC Re-Alignment، کالیبراسیون احتمالات Platt
        Scaling، تصحیح ابهام آوایی با مدل زبان دوجانبه، بازسازی کلمات مرکب و
        نیم‌فاصله‌ها، نرمال‌سازی دوطرفه اعداد و مبالغ فارسی، فیلتر پیش‌ازASR
        موسیقی تیتراژ و استخراج کلیدواژه با RAKE فارسی.
4.  زیرساخت کامل سرور Backend (Node.js + Fastify + PostgreSQL):
      - احراز هویت scrypt + EdDSA JWT، لایسنس آفلاین امضاشده با Ed25519 و کنترل
        سقف دستگاه‌ها، توزیع تکه‌های ۸ مگابایتی با HTTP 206 Byte-Range، وب‌هوک
        پرداخت با Idempotency، کلیدهای سازمانی B2B با مصرف اتمیک سهمیه، Canary
        Rollout و Auto-Rollback، کش Single-Flight، قفل مشورتی توزیع‌شده، الگوی
        Outbox تراکنشی، ناظر سلامت کارگرها (Watchdog) و خروجی متریک‌های
        Prometheus.

