// apps/platform-backend/__tests__/SpeakerTurnAndEnterpriseKey.spec.ts
import { describe, it, expect } from 'vitest';
import { SpeakerTurnBoundaryWordAligner } from '../../../packages/ai-engine/src/asr/SpeakerTurnBoundaryWordAligner';
import { EnterpriseApiKeyAndQuotaManager } from '../src/auth/EnterpriseApiKeyAndQuotaManager';
import { AsrWorkerSupervisorAndWatchdog } from '../src/asr-worker/AsrWorkerSupervisorAndWatchdog';
import { PersianTextNormalizer } from '../../../packages/ai-engine/src/PersianTextNormalizer';
