import { PgPoolLike } from '../src/PlatformBackendServices';
import { TimeMath } from '../../../packages/contracts/src/timebase.contract';

describe('Speaker Turn Alignment, Enterprise API Quota & Watchdog Supervisor Suite', () => {
  it('1. SpeakerTurnBoundaryWordAligner splits speaker turns cleanly by overlap ratio and ignores crosstalk bleed', () => {
    const tokens = PersianTextNormalizer.buildThreeLayerTranscript([
      { id: '1', text: 'سلام', range: { start: 0, end: TimeMath.secondsToFlicks(0.4) }, confidence: 0.95 },
      // کلمه «بفرمایید» ۷۵٪ با گوینده ۱ و ۲۵٪ با گوینده ۲ هم‌پوشانی دارد -> باید متعلق به گوینده ۱ بماند!
      { id: '2', text: 'بفرمایید', range: { start: TimeMath.secondsToFlicks(0.5), end: TimeMath.secondsToFlicks(0.9) }, confidence: 0.93 },
