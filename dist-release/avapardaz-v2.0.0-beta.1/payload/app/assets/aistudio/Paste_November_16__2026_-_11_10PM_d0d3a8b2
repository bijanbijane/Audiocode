در ادامه مسیر متمرکز بر هسته موتور تشخیص گفتار فارسی (Core ASR Engine) و
سرویس‌های Backend، سه ماژول تخصصی و بسیار کاربردی را پیاده‌سازی
می‌کنیم:

1.  بخش صد‌وچهل‌ونهم: دروازه استریم زنده صوت از طریق WebSocket در Backend
    (WebSocketLiveAsrGateway.ts) — دریافت پیوسته بسته‌های باینری PCM 16-bit /
    Float32 از کلاینت‌های سازمانی (پشت دروازه احراز هویت
    EnterpriseApiKeyAndQuotaManager و پرچم نسخه ۱)، مدیریت دقیق بایت‌های
    نصفه‌کاره در مرز بسته‌های شبکه، کسر متناوب سهمیه صوتی، کنترل Backpressure و
    ارسال رویدادهای لحظه‌ای COMMITTED_WORDS، TENTATIVE_TAIL و UTTERANCE_ENDPOINT
    بر پایه LocalAgreement-2 و PersianSyntacticAcousticEndpointDetector.
2.  بخش صد‌وپنجاهم: استخر نشست‌های ONNX و مدیر پیش‌گرم‌سازی مدل در سرور
    (NodeAsrModelSessionPool.ts) — جلوگیری از بارگذاری تکراری مدل روی هر درخواست
    و جلوگیری از کرش حافظه یا تخلیه زودهنگام مدل در میانه استریم از طریق شمارنده
    ارجاع (Reference Counting)، پیش‌گرم‌سازی با تانسور مصنوعی (Startup Warm-Up)
    و تخلیه ایمن LRU بر اساس سقف حافظه سرور.
3.  بخش صد‌وپنجاه‌ویکم: مجموعه تست‌های خودکار Vitest برای استریم WebSocket،
    بایت‌های مرزی split‌شده و استخر نشست‌های مدل
    (WebSocketAsrAndSessionPool.spec.ts).

بخش صد‌وچهل‌ونهم: دروازه استریم زنده صوت از طریق WebSocket (WebSocketLiveAsrGateway.ts)

در ارتباطات زنده WebSocket، دو خطای مهلک در پیاده‌سازی‌های معمولی رخ می‌دهد:

1.  شبکه TCP بسته‌های صوتی را بدون توجه به مرز ۲ بایتی نمونه‌های Int16 تکه
    می‌کند (مثلاً بسته اول ۳۲۱ بایت است و بسته دوم ۳۱۹ بایت). اگر کد مستقیماً
    روی بافر هر بسته Int16Array بسازد، کل ادامه صدای کاربر دچار نویز سفید شدید
    (Byte-Misalignment Static) می‌شود!
2.  اگر کلاینت با سرعت بیشتر از توان GPU/CPU سرور صوت بفرستد، صف حافظه پر شده و
    سرور سقوط می‌کند.

کد زیر هر دو مشکل را با نگهدارنده تک‌بایت باقی‌مانده (pendingOddByte) و صف دارای
سقف Backpressure حل کرده و خروجی لحظه‌ای کلمات فارسی را برمی‌گرداند:

// apps/platform-backend/src/gateway/WebSocketLiveAsrGateway.ts
import { EnterpriseApiKeyAndQuotaManager } from '../auth/EnterpriseApiKeyAndQuotaManager';
import {
  LocalAgreement2StreamStabilizer,
  StreamingAsrHypothesisUpdate,
} from '../../../../packages/ai-engine/src/asr/StreamingLivePersianAsrEngine';
import { PersianSyntacticAcousticEndpointDetector } from '../../../../packages/ai-engine/src/asr/PersianSyntacticAcousticEndpointDetector';
import { PreAsrInputSanityValidator } from '../../../../packages/ai-engine/src/asr/PreAsrInputSanityValidator';
import { RawWordPrediction } from '../../../../packages/ai-engine/src/PersianChunkedAsrWorker';

export interface LiveWsSocketLike {
  send(jsonText: string): void;
  close(code: number, reason: string): void;
}

export type LiveWsOutgoingEvent =
  | { type: 'SESSION_READY'; sessionId: string; remainingQuotaSeconds: number }
  | { type: 'HYPOTHESIS_UPDATE'; update: StreamingAsrHypothesisUpdate }
  | { type: 'UTTERANCE_ENDPOINT'; trailingSilenceMs: number; reasonTag: string }
  | { type: 'BACKPRESSURE_WARNING'; droppedOrPaused: boolean }
  | { type: 'QUOTA_EXHAUSTED'; messageFa: string }
  | { type: 'ERROR'; code: string; messageFa: string };

export class LiveWsAsrSessionController {
  private readonly stabilizer: LocalAgreement2StreamStabilizer;
  private readonly endpointDetector = new PersianSyntacticAcousticEndpointDetector(650, 1450);

  private pendingOddByte: number | null = null;
  private bufferedPcm16kChunks: Float32Array[] = [];
  private isProcessingQueue = false;
  private isClosed = false;

  private committedWordsHistory: string[] = [];
  private accumulatedUnbilledSamples = 0;
  private silenceStreakSamples = 0;

  private readonly maxPendingChunksQueue = 16; // سقف Backpressure: حداکثر ۱۶ بسته منتظر
  private readonly quotaChargeIntervalSamples = 16000 * 5; // کسر سهمیه در بازه‌های ۵ ثانیه‌ای

  constructor(
    private readonly sessionId: string,
    private readonly enterpriseKeyId: string,
    private readonly quotaManager: EnterpriseApiKeyAndQuotaManager,
    private readonly socket: LiveWsSocketLike,
    transcribeWindowFn: (pcm16k: Float32Array) => Promise<RawWordPrediction[]>
  ) {
    this.stabilizer = new LocalAgreement2StreamStabilizer(transcribeWindowFn, 0.35, 20.0);
  }

  /**
   * ۱. دریافت بسته باینری Int16 Little-Endian 16kHz Mono از سوکت با حفظ تراز ۲ بایتی بین بسته‌ها
   */
  public async handleIncomingInt16BinaryFrame(rawBytes: Uint8Array): Promise<void> {
    if (this.isClosed || rawBytes.byteLength === 0) return;

    if (this.bufferedPcm16kChunks.length >= this.maxPendingChunksQueue) {
      this.emit({ type: 'BACKPRESSURE_WARNING', droppedOrPaused: true });
      return;
    }

    // بازسازی نمونه کامل Int16 در صورت باقی ماندن تک‌بایت فرد از بسته قبلی
    let offset = 0;
    const samplesList: number[] = [];

    if (this.pendingOddByte !== null) {
      const lo = this.pendingOddByte;
      const hi = rawBytes[0];
      this.pendingOddByte = null;
      offset = 1;
      let int16 = lo | (hi << 8);
      if (int16 & 0x8000) int16 -= 0x10000;
      samplesList.push(int16 / 32768.0);
    }

    while (offset + 1 < rawBytes.byteLength) {
      const lo = rawBytes[offset];
      const hi = rawBytes[offset + 1];
      let int16 = lo | (hi << 8);
      if (int16 & 0x8000) int16 -= 0x10000;
      samplesList.push(int16 / 32768.0);
      offset += 2;
    }

    if (offset < rawBytes.byteLength) {
      this.pendingOddByte = rawBytes[offset];
    }

    if (samplesList.length === 0) return;

    const pcmChunk = Float32Array.from(samplesList);
    PreAsrInputSanityValidator.validateAndSanitizeForAsr(pcmChunk);

    this.bufferedPcm16kChunks.push(pcmChunk);
    void this.drainProcessingQueue();
  }

  private async drainProcessingQueue(): Promise<void> {
    if (this.isProcessingQueue || this.isClosed) return;
    this.isProcessingQueue = true;

    try {
      while (this.bufferedPcm16kChunks.length > 0 && !this.isClosed) {
        const chunk = this.bufferedPcm16kChunks.shift()!;

        // ۱. بررسی مصرف سهمیه سازمانی هر ۵ ثانیه یک‌بار
        this.accumulatedUnbilledSamples += chunk.length;
        if (this.accumulatedUnbilledSamples >= this.quotaChargeIntervalSamples) {
          const billedSec = Math.floor(this.accumulatedUnbilledSamples / 16000);
          this.accumulatedUnbilledSamples %= 16000;

          const quotaRes = await this.quotaManager.consumeAudioQuotaAtomically(
            this.enterpriseKeyId,
            billedSec
          );
          if (!quotaRes.approved) {
            this.emit({
              type: 'QUOTA_EXHAUSTED',
              messageFa: 'سهمیه صوتی ماهانه کلید سازمانی به پایان رسیده است.',
            });
            this.closeSession(1008, 'QUOTA_EXHAUSTED');
            return;
          }
        }

        // ۲. پایش سکوت انتهایی برای تشخیص پایان جمله فارسی (Endpointing)
        if (this.isChunkSilence(chunk)) {
          this.silenceStreakSamples += chunk.length;
        } else {
          this.silenceStreakSamples = 0;
        }

        // ۳. اجرای پایدارساز LocalAgreement-2 + Draft Horizon
        const update = await this.stabilizer.pushAudioChunkAndTranscribe(chunk);
        for (const w of update.newlyCommittedWords) {
          this.committedWordsHistory.push(w.word);
        }

        if (
          update.newlyCommittedWords.length > 0 ||
          update.tentativeTailWords.length > 0
        ) {
          this.emit({ type: 'HYPOTHESIS_UPDATE', update });
        }

        // ۴. بررسی پایان جمله نحوی-آکوستیکی (جلوگیری از برش روی مکث میانه جمله پس از «که» یا «برای»)
        const silenceMs = (this.silenceStreakSamples / 16000) * 1000;
        if (silenceMs >= 300 && this.committedWordsHistory.length > 0) {
          const ep = this.endpointDetector.evaluateEndOfUtterance({
            trailingSilenceMs: silenceMs,
            recentRecognizedWords: this.committedWordsHistory.slice(-5),
          });
          if (ep.decision === 'UTTERANCE_ENDPOINT_REACHED') {
            this.emit({
              type: 'UTTERANCE_ENDPOINT',
              trailingSilenceMs: Math.round(silenceMs),
              reasonTag: ep.reasonTag,
            });
            this.silenceStreakSamples = 0;
          }
        }
      }
    } finally {
      this.isProcessingQueue = false;
    }
  }

  public async finalizeAndClose(): Promise<void> {
    if (this.isClosed) return;
    if (this.accumulatedUnbilledSamples > 0) {
      const remSec = Math.max(1, Math.ceil(this.accumulatedUnbilledSamples / 16000));
      this.accumulatedUnbilledSamples = 0;
      await this.quotaManager
        .consumeAudioQuotaAtomically(this.enterpriseKeyId, remSec)
        .catch(() => {});
    }
    this.closeSession(1000, 'CLIENT_CLOSED');
  }

  private closeSession(code: number, reason: string): void {
    this.isClosed = true;
    this.bufferedPcm16kChunks = [];
    this.socket.close(code, reason);
  }

  private isChunkSilence(chunk: Float32Array): boolean {
    let sumSq = 0;
    for (let i = 0; i < chunk.length; i++) sumSq += chunk[i] * chunk[i];
    const rmsDb = 10 * Math.log10(sumSq / Math.max(1, chunk.length) + 1e-12);
    return rmsDb < -44.0;
  }

  private emit(evt: LiveWsOutgoingEvent): void {
    if (!this.isClosed) {
      this.socket.send(JSON.stringify(evt));
    }
  }
}

export class WebSocketLiveAsrGateway {
  constructor(
    private readonly quotaManager: EnterpriseApiKeyAndQuotaManager,
    /** قانون ۳ سند معماری: استنتاج زنده سمت سرور در نسخه اول غیرفعال است و فقط با پرچم Enterprise فعال می‌شود */
    private readonly enableServerSideAsrInference: boolean
  ) {}

  public async openAuthenticatedSession(params: {
    enterpriseApiKey: string;
    socket: LiveWsSocketLike;
    transcribeWindowFn: (pcm16k: Float32Array) => Promise<RawWordPrediction[]>;
  }): Promise<LiveWsAsrSessionController | null> {
    if (!this.enableServerSideAsrInference) {
      params.socket.send(
        JSON.stringify({
          type: 'ERROR',
          code: 'CLOUD_ASR_DISABLED_IN_V1',
          messageFa: 'طبق قانون ۳ معماری، پردازش زنده ASR سمت سرور در نسخه اول غیرفعال است.',
        })
      );
      params.socket.close(1008, 'CLOUD_ASR_DISABLED_IN_V1');
      return null;
    }

    try {
      const ctx = await this.quotaManager.authenticateAndAuthorizeScope(
        params.enterpriseApiKey,
        'CLOUD_ASR_ENTERPRISE'
      );
      if (ctx.remainingAudioSeconds <= 0) {
        throw new Error('QUOTA_EXHAUSTED');
      }

      const sessionId = `ws_asr_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;
      params.socket.send(
        JSON.stringify({
          type: 'SESSION_READY',
          sessionId,
          remainingQuotaSeconds: ctx.remainingAudioSeconds,
        })
      );

      return new LiveWsAsrSessionController(
        sessionId,
        ctx.keyId,
        this.quotaManager,
        params.socket,
        params.transcribeWindowFn
      );
    } catch (err) {
      const code = err instanceof Error ? err.message : 'UNAUTHORIZED';
      params.socket.send(
        JSON.stringify({
          type: 'ERROR',
          code,
          messageFa: 'احراز هویت یا سهمیه کلید سازمانی معتبر نیست.',
        })
      );
      params.socket.close(1008, code);
      return null;
    }
  }
}

بخش صد‌وپنجاهم: استخر نشست‌های ONNX و مدیر پیش‌گرم‌سازی مدل در سرور (NodeAsrModelSessionPool.ts)

در سرور استنتاج Node.js، ساخت InferenceSession جدید برای هر درخواست غیرممکن است
(چون هم تاخیر ۱ تا ۳ ثانیه‌ای دارد و هم رم را منفجر می‌کند). از طرف دیگر، اگر یک
مدل در حال سرویس‌دهی به ۵ کاربر هم‌زمان باشد، نباید توسط مکانیسم LRU از حافظه
تخلیه شود.

این کلاس موارد زیر را تضمین می‌کند:

1.  پیش‌گرم‌سازی در لحظه بارگذاری (Warm-Up Dry Pass): بلافاصله پس از
    createSession، یک تانسور سکوت کوتاه از گراف عبور داده می‌شود تا کش‌های JIT و
    تخصیص‌گرهای حافظه onnxruntime-node پیش از ورود اولین کاربر آماده شوند.
2.  اجاره دارای شمارنده ارجاع (Reference-Counted Session Lease): هر درخواست پیش
    از استفاده acquireSession و در finally متد release() را صدا می‌زند. تا زمانی
    که activeLeases > 0 باشد، تخلیه مدل اکیداً ممنوع است.
3.  تخلیه ایمن LRU بر اساس بودجه حافظه (maxMemoryBudgetMb): در هنگام بارگذاری
    مدل جدید، فقط نشست‌های بیکار (activeLeases === 0) به ترتیب قدیمی‌ترین زمان
    استفاده تخلیه می‌شوند.

// apps/platform-backend/src/asr-worker/NodeAsrModelSessionPool.ts
import {
  OrtRuntimeProvider,
  OrtSessionLike,
  OrtTensorLike,
} from '../../../../packages/ai-engine/src/asr/UnifiedOnnxPersianAsrEngine';

export interface ModelPoolDescriptor {
  readonly modelKey: string; // e.g. "fastconformer-fa:1.2.0"
  readonly modelPathOrBytes: string | Uint8Array;
  readonly estimatedMemoryFootprintMb: number;
  readonly executionProviders: ('cuda' | 'cpu')[];
  readonly buildWarmupDummyFeeds?: () => Record<string, OrtTensorLike>;
}

interface PooledSessionRecord {
  readonly descriptor: ModelPoolDescriptor;
  readonly session: OrtSessionLike;
  activeLeases: number;
  lastUsedAtMs: number;
}

export class NodeAsrModelSessionPool {
  private readonly pool = new Map<string, PooledSessionRecord>();
  private readonly loadingPromises = new Map<string, Promise<PooledSessionRecord>>();
  private totalAllocatedMb = 0;

  constructor(
    private readonly ortProvider: OrtRuntimeProvider,
    private readonly maxMemoryBudgetMb: number = 4096
  ) {}

  /**
   * ۱. دریافت نشست آماده و پیش‌گرم‌شده با افزایش شمارنده ارجاع (جلوگیری از Unload شدن در حین استنتاج!)
   */
  public async acquireSession(descriptor: ModelPoolDescriptor): Promise<{
    session: OrtSessionLike;
    release: () => void;
  }> {
    let record = this.pool.get(descriptor.modelKey);

    if (!record) {
      // جلوگیری از بارگذاری مضاعف هم‌زمان یک مدل توسط دو درخواست (Single-Flight Load)
      let loading = this.loadingPromises.get(descriptor.modelKey);
      if (!loading) {
        loading = this.loadAndWarmupModel(descriptor);
        this.loadingPromises.set(descriptor.modelKey, loading);
      }

      try {
        record = await loading;
      } finally {
        this.loadingPromises.delete(descriptor.modelKey);
      }
    }

    record.activeLeases++;
    record.lastUsedAtMs = Date.now();

    let released = false;
    return {
      session: record.session,
      release: () => {
        if (released) return;
        released = true;
        record!.activeLeases = Math.max(0, record!.activeLeases - 1);
        record!.lastUsedAtMs = Date.now();
      },
    };
  }

  private async loadAndWarmupModel(
    descriptor: ModelPoolDescriptor
  ): Promise<PooledSessionRecord> {
    await this.evictIdleSessionsIfNeeded(descriptor.estimatedMemoryFootprintMb);

    const session = await this.ortProvider.createSession(
      descriptor.modelPathOrBytes,
      descriptor.executionProviders
    );

    // اجرای یک پاس پیش‌گرم‌سازی (Warm-Up) پیش از سرویس‌دهی به اولین کاربر واقعی
    if (descriptor.buildWarmupDummyFeeds) {
      await session.run(descriptor.buildWarmupDummyFeeds());
    }

    const record: PooledSessionRecord = {
      descriptor,
      session,
      activeLeases: 0,
      lastUsedAtMs: Date.now(),
    };
    this.pool.set(descriptor.modelKey, record);
    this.totalAllocatedMb += descriptor.estimatedMemoryFootprintMb;
    return record;
  }

  /**
   * ۲. تخلیه ایمن نشست‌های بیکار (activeLeases === 0) به ترتیب LRU برای آزادسازی فضا
   */
  private async evictIdleSessionsIfNeeded(incomingMb: number): Promise<void> {
    if (this.totalAllocatedMb + incomingMb <= this.maxMemoryBudgetMb) return;

    const idleCandidates = Array.from(this.pool.values())
      .filter((r) => r.activeLeases === 0)
      .sort((a, b) => a.lastUsedAtMs - b.lastUsedAtMs);

    for (const candidate of idleCandidates) {
      if (this.totalAllocatedMb + incomingMb <= this.maxMemoryBudgetMb) break;

      this.pool.delete(candidate.descriptor.modelKey);
      this.totalAllocatedMb = Math.max(
        0,
        this.totalAllocatedMb - candidate.descriptor.estimatedMemoryFootprintMb
      );
      if (candidate.session.release) {
        await candidate.session.release();
      }
    }

    if (this.totalAllocatedMb + incomingMb > this.maxMemoryBudgetMb) {
      throw new Error(
        `SESSION_POOL_MEMORY_EXHAUSTED: فضای حافظه برای بارگذاری ${incomingMb}MB کافی نیست و تمام نشست‌های فعلی در حال کارند.`
      );
    }
  }

  public getPoolStats(): {
    loadedModelsCount: number;
    totalAllocatedMb: number;
    activeTotalLeases: number;
  } {
    let activeTotalLeases = 0;
    for (const r of this.pool.values()) activeTotalLeases += r.activeLeases;
    return {
      loadedModelsCount: this.pool.size,
      totalAllocatedMb: this.totalAllocatedMb,
      activeTotalLeases,
    };
  }
}

بخش صد‌وپنجاه‌ویکم: تست‌های خودکار Vitest برای WebSocket زنده و استخر نشست‌های مدل (WebSocketAsrAndSessionPool.spec.ts)

// apps/platform-backend/__tests__/WebSocketAsrAndSessionPool.spec.ts
import { describe, it, expect } from 'vitest';
import {
  LiveWsSocketLike,
  WebSocketLiveAsrGateway,
} from '../src/gateway/WebSocketLiveAsrGateway';
import { NodeAsrModelSessionPool } from '../src/asr-worker/NodeAsrModelSessionPool';
import { EnterpriseApiKeyAndQuotaManager } from '../src/auth/EnterpriseApiKeyAndQuotaManager';
import { PgPoolLike } from '../src/PlatformBackendServices';
import {
  OrtRuntimeProvider,
  OrtSessionLike,
  OrtTensorLike,
} from '../../../packages/ai-engine/src/asr/UnifiedOnnxPersianAsrEngine';

describe('WebSocket Live ASR Gateway & Reference-Counted ONNX Session Pool Suite', () => {
  it('1. WebSocketLiveAsrGateway enforces V1 policy, handles split odd-byte Int16 PCM packets, and emits stabilized Persian updates', async () => {
    let remainingUsed = 0;
    const mockDb: PgPoolLike = {
      async query(sql, params = []) {
        if (sql.includes('SELECT key_id, organization_id')) {
          return {
            rows: [
              {
                key_id: 'k_ws_1',
                organization_id: 'org_1',
                scopes: ['CLOUD_ASR_ENTERPRISE'],
                monthly_audio_seconds_limit: '1000',
                monthly_audio_seconds_used: String(remainingUsed),
                revoked: false,
                expires_at: null,
              },
            ] as any,
            rowCount: 1,
          };
        }
        if (sql.includes('UPDATE enterprise_api_keys')) {
          remainingUsed += params[1] as number;
          return {
            rows: [
              {
                monthly_audio_seconds_used: String(remainingUsed),
                monthly_audio_seconds_limit: '1000',
              },
            ] as any,
            rowCount: 1,
          };
        }
        return { rows: [], rowCount: 0 };
      },
    };

    const quotaMgr = new EnterpriseApiKeyAndQuotaManager(mockDb);
    const sentMessages: any[] = [];
    let closedCode: number | null = null;

    const fakeSocket: LiveWsSocketLike = {
      send: (txt) => sentMessages.push(JSON.parse(txt)),
      close: (code) => {
        closedCode = code;
      },
    };

    // الف) بررسی قفل بودن در نسخه اول وقتی enableServerSideAsrInference=false است
    const v1LockedGateway = new WebSocketLiveAsrGateway(quotaMgr, false);
    const blockedCtrl = await v1LockedGateway.openAuthenticatedSession({
      enterpriseApiKey: 'paudio_live_000111',
      socket: fakeSocket,
      transcribeWindowFn: async () => [],
    });
    expect(blockedCtrl).toBeNull();
    expect(closedCode).toBe(1008);
    expect(sentMessages[0].code).toBe('CLOUD_ASR_DISABLED_IN_V1');

    // ب) تست حالت فعال سازمانی: تقسیم یک بافر Int16 با مرز بایتی فرد بین دو بسته WebSocket
    sentMessages.length = 0;
    closedCode = null;
    const enterpriseGateway = new WebSocketLiveAsrGateway(quotaMgr, true);

    let pass = 0;
    const receivedSampleLengths: number[] = [];
    const ctrl = await enterpriseGateway.openAuthenticatedSession({
      enterpriseApiKey: 'paudio_live_000111',
      socket: fakeSocket,
      transcribeWindowFn: async (pcm) => {
        receivedSampleLengths.push(pcm.length);
        pass++;
        // بازگرداندن کلمه «سلام» در بازه [0.1s..0.4s] خارج از Draft Horizon
        return [
          { word: 'سلام', relativeStartSec: 0.1, relativeEndSec: 0.4, probability: 0.96 },
        ];
      },
    });
    expect(ctrl).not.toBeNull();
    expect(sentMessages[0].type).toBe('SESSION_READY');

    // ساخت ۱ ثانیه صوت Int16 (16000 نمونه = 32000 بایت) و برش آن در بایت فرد (16001 و 15999)
    const fullInt16 = new Int16Array(16000);
    fullInt16.fill(8192);
    const rawBytes = new Uint8Array(fullInt16.buffer);

    await ctrl!.handleIncomingInt16BinaryFrame(rawBytes.subarray(0, 16001)); // ۸۰۰۰ نمونه + ۱ بایت فرد!
    await ctrl!.handleIncomingInt16BinaryFrame(rawBytes.subarray(16001));    // ۱ بایت مانده + ۷۹۹۹ نمونه = ۸۰۰۰ نمونه دقیق!

    await new Promise((r) => setTimeout(r, 30));
    await ctrl!.finalizeAndClose();

    // مجموع نمونه‌های دریافتی در دو گام باید دقیقاً 8000 و سپس 16000 باشد (بدون گم شدن حتی ۱ نمونه!)
    expect(receivedSampleLengths[0]).toBe(8000);
    expect(receivedSampleLengths[1]).toBe(16000);

    const hypothesisEvent = sentMessages.find((m) => m.type === 'HYPOTHESIS_UPDATE');
    expect(hypothesisEvent).toBeDefined();
    expect(hypothesisEvent.update.newlyCommittedWords[0].word).toBe('سلام');
  });

  it('2. NodeAsrModelSessionPool warms up models once, protects actively leased models, and evicts idle LRU models', async () => {
    let warmupRuns = 0;
    let releasedModelKeys: string[] = [];

    const mockOrt: OrtRuntimeProvider = {
      createTensor: (type, data, dims) => ({ type, data, dims } as OrtTensorLike),
      createSession: async (key): Promise<OrtSessionLike> => ({
        run: async () => {
          warmupRuns++;
          return {};
        },
        release: async () => {
          releasedModelKeys.push(String(key));
        },
      }),
    };

    const pool = new NodeAsrModelSessionPool(mockOrt, 1000); // سقف 1000MB

    const modelA = {
      modelKey: 'model_A',
      modelPathOrBytes: 'model_A',
      estimatedMemoryFootprintMb: 600,
      executionProviders: ['cpu'] as ('cuda' | 'cpu')[],
      buildWarmupDummyFeeds: () => ({}),
    };
    const modelB = {
      modelKey: 'model_B',
      modelPathOrBytes: 'model_B',
      estimatedMemoryFootprintMb: 600,
      executionProviders: ['cpu'] as ('cuda' | 'cpu')[],
      buildWarmupDummyFeeds: () => ({}),
    };

    // بارگذاری و اجاره مدل A (600MB)
    const leaseA = await pool.acquireSession(modelA);
    expect(warmupRuns).toBe(1);

    // تا زمانی که leaseA آزاد نشده، مدل B (600MB) نمی‌تواند مدل A را تخلیه کند!
    await expect(pool.acquireSession(modelB)).rejects.toThrow('SESSION_POOL_MEMORY_EXHAUSTED');

    // پس از آزادسازی leaseA، مدل B باید مدل A بیکار را با الگوریتم LRU تخلیه و جایگزین کند
    leaseA.release();
    const leaseB = await pool.acquireSession(modelB);
    expect(releasedModelKeys).toEqual(['model_A']);
    expect(pool.getPoolStats().totalAllocatedMb).toBe(600);
    leaseB.release();
  });
});

