بخش صد‌وپنجاه‌ودوم: خروجی استاندارد پژوهش و خطایابی گفتار Praat TextGrid و NIST CTM (PraatTextGridAndLinguisticExporter.ts)

هر تیم مهندسی تشخیص گفتار برای بررسی دقیق خطاهای زمان‌بندی (تأخیر در مرز واج‌ها،
خطای VAD یا هم‌پوشانی گویندگان) نیازمند باز کردن خروجی موتور ASR در کنار موج
صوتی در ابزارهای استاندارد مانند Praat یا ارزیابی با NIST SCLite است.

دو قانون سخت‌گیرانه فرمت Praat TextGrid که در کد زیر تضمین شده‌اند:

1.  در هر IntervalTier، بازه‌ها باید دقیقاً از 0 تا xmax کاملاً پیوسته و بدون
    حتی یک میلی‌ثانیه شکاف باشند (بنابراین فاصله بین دو کلمه باید به صورت صریح
    با بازه تهی "" پر شود).
2.  اگر مدل در نقطه‌ای هم‌پوشانی کوچک زمانی بین دو کلمه مجاور داده باشد، مرزها
    به صورت یکنوا (Monotonic Clamping) اصلاح می‌شوند تا Praat خطای ترتیب بازه
    صادر نکند.

// packages/ai-engine/src/asr/PraatTextGridAndLinguisticExporter.ts
import { TimedPersianToken } from '../PersianTextNormalizer';
import { SpeakerTimelineSegment } from '../MultiSpeakerDiarizationAndCrosstalkEngine';
import { DetectedSpeechIssue } from '../PersianDisfluencyEngine';
import { TimeMath } from '../../../contracts/src/timebase.contract';

export interface TextGridInterval {
  readonly xmin: number;
  readonly xmax: number;
  readonly text: string;
}

export class PraatTextGridAndLinguisticExporter {
  /**
   * ۱. تولید فایل استاندارد Praat TextGrid شامل ۳ لایه هم‌زمان:
   * - لایه ۱: کلمات فارسی زمان‌بندی‌شده (words)
   * - لایه ۲: گویندگان و هم‌پوشانی‌ها (speakers)
   * - لایه ۳: تپق‌ها و مکث‌های تشخیص‌داده‌شده (disfluencies)
   */
  public static exportToPraatTextGrid(params: {
    totalAudioDurationSec: number;
    tokens: TimedPersianToken[];
    speakerSegments?: SpeakerTimelineSegment[];
    disfluencyIssues?: DetectedSpeechIssue[];
  }): string {
    const xmax = Math.max(
      params.totalAudioDurationSec,
      params.tokens.length > 0
        ? TimeMath.flicksToSeconds(params.tokens[params.tokens.length - 1].range.end)
        : 0.01
    );

    const tiers: { name: string; intervals: TextGridInterval[] }[] = [];

    // لایه ۱: کلمات فارسی (با پر کردن تمام شکاف‌های سکوت برای حفظ پیوستگی مطلق بازه‌ها)
    const rawWordIntervals = params.tokens.map((t) => ({
      xmin: TimeMath.flicksToSeconds(t.range.start),
      xmax: TimeMath.flicksToSeconds(t.range.end),
      text: t.displayText,
    }));
    tiers.push({
      name: 'words',
      intervals: this.makeStrictlyContiguousIntervals(rawWordIntervals, xmax),
    });

    // لایه ۲: گویندگان (در صورت وجود خروجی Diarization)
    if (params.speakerSegments && params.speakerSegments.length > 0) {
      const rawSpkIntervals = params.speakerSegments.map((s) => ({
        xmin: TimeMath.flicksToSeconds(s.range.start),
        xmax: TimeMath.flicksToSeconds(s.range.end),
        text:
          s.classification === 'CROSSTALK_MIC_BLEED'
            ? `${s.speakerId}[BLEED]`
            : s.speakerId,
      }));
      tiers.push({
        name: 'speakers',
        intervals: this.makeStrictlyContiguousIntervals(rawSpkIntervals, xmax),
      });
    }

    // لایه ۳: ایرادهای گفتاری (تپق‌ها و مکث‌های غیرطبیعی)
    if (params.disfluencyIssues && params.disfluencyIssues.length > 0) {
      const rawIssueIntervals = params.disfluencyIssues.map((iss) => ({
        xmin: TimeMath.flicksToSeconds(iss.targetRange.start),
        xmax: TimeMath.flicksToSeconds(iss.targetRange.end),
        text: `${iss.type}: ${iss.displayExcerpt}`,
      }));
      tiers.push({
        name: 'disfluencies',
        intervals: this.makeStrictlyContiguousIntervals(rawIssueIntervals, xmax),
      });
    }

    const lines: string[] = [
      `File type = "ooTextFile"`,
      `Object class = "TextGrid"`,
      ``,
      `xmin = 0`,
      `xmax = ${xmax.toFixed(6)}`,
      `tiers? <exists>`,
      `size = ${tiers.length}`,
      `item []:`,
    ];

    tiers.forEach((tier, tIdx) => {
      lines.push(
        `    item [${tIdx + 1}]:`,
        `        class = "IntervalTier"`,
        `        name = "${this.escapePraatString(tier.name)}"`,
        `        xmin = 0`,
        `        xmax = ${xmax.toFixed(6)}`,
        `        intervals: size = ${tier.intervals.length}`
      );

      tier.intervals.forEach((inv, iIdx) => {
        lines.push(
          `        intervals [${iIdx + 1}]:`,
          `            xmin = ${inv.xmin.toFixed(6)}`,
          `            xmax = ${inv.xmax.toFixed(6)}`,
          `            text = "${this.escapePraatString(inv.text)}"`
        );
      });
    });

    return lines.join('\n') + '\n';
  }

  /**
   * ۲. تولید خروجی استاندارد NIST CTM (Conversation Time-Marked) برای ابزارهای ارزیابی ASR
   * فرمت: <utterance_id> <channel> <start_sec> <duration_sec> <word> <confidence>
   */
  public static exportToNistCtm(
    utteranceId: string,
    tokens: TimedPersianToken[],
    channelNumber: number = 1
  ): string {
    return tokens
      .map((tok) => {
        const startSec = TimeMath.flicksToSeconds(tok.range.start);
        const durSec = Math.max(
          0.01,
          TimeMath.flicksToSeconds(tok.range.end - tok.range.start)
        );
        return `${utteranceId} ${channelNumber} ${startSec.toFixed(3)} ${durSec.toFixed(
          3
        )} ${tok.normalizedText} ${tok.confidence.toFixed(3)}`;
      })
      .join('\n');
  }

  /**
   * تضمین پیوستگی ریاضی کامل بازه‌ها از 0 تا xmax (الزام قطعی نرم‌افزار Praat)
   */
  private static makeStrictlyContiguousIntervals(
    raw: TextGridInterval[],
    totalDurationSec: number
  ): TextGridInterval[] {
    const sorted = [...raw]
      .filter((r) => r.xmax > r.xmin)
      .sort((a, b) => a.xmin - b.xmin);

    const contiguous: TextGridInterval[] = [];
    let cursor = 0;

    for (const item of sorted) {
      const start = Math.max(cursor, Math.min(totalDurationSec, item.xmin));
      const end = Math.max(start, Math.min(totalDurationSec, item.xmax));
      if (end <= start) continue;

      if (start - cursor > 0.0005) {
        contiguous.push({ xmin: cursor, xmax: start, text: '' });
      }
      contiguous.push({
        xmin: start,
        xmax: end,
        text: item.text,
      });
      cursor = end;
    }

    if (totalDurationSec - cursor > 0.0005) {
      contiguous.push({ xmin: cursor, xmax: totalDurationSec, text: '' });
    }

    if (contiguous.length === 0) {
      contiguous.push({ xmin: 0, xmax: totalDurationSec, text: '' });
    }

    return contiguous;
  }

  private static escapePraatString(str: string): string {
    return str.replace(/"/g, '""');
  }
}

بخش صد‌وپنجاه‌وسوم: گاوصندوق رمزنگاری پوششی وزن‌های اختصاصی مدل روی سرور (ServerSideEncryptedModelVault.ts)

هنگامی که تیم هوش مصنوعی مدل‌های فارسی اختصاصی و بهینه‌سازی‌شده را روی سرورهای
استنتاج (یا کارگرهای آینده) مستقر می‌کند، نگهداری فایل خام .onnx روی دیسک ریسک
کپی‌برداری یا دستکاری فایل را به همراه دارد.

این کلاس از الگوی استاندارد Envelope Encryption (AES-256-GCM) استفاده می‌کند:

1.  برای هر مدل یک کلید داده ۲۵۶ بیتی یکتا (DEK) تولید می‌شود و وزن‌های مدل با
    آن و با اتصال AAD (modelId:version) رمزنگاری می‌شوند.
2.  کلید DEK با کلید اصلی سرور (KEK) رمزنگاری (Wrap) شده و در هدر بسته باینری
    (EMV1) ذخیره می‌گردد.
3.  هنگام بارگذاری در NodeAsrModelSessionPool، مدل مستقیماً در حافظه (Buffer /
    Uint8Array) رمزگشایی و به onnxruntime-node داده می‌شود بدون آنکه حتی یک بایت
    از وزن‌های رمزگشایی‌شده روی دیسک نوشته شود!

// apps/platform-backend/src/security/ServerSideEncryptedModelVault.ts
import crypto from 'node:crypto';

export interface EncryptedModelEnvelopeMetadata {
  readonly modelId: string;
  readonly version: string;
  readonly plaintextByteLength: number;
}

export class ServerSideEncryptedModelVault {
  private static readonly MAGIC = Buffer.from('EMV1', 'ascii'); // Encrypted Model Vault v1
  private readonly masterKekBytes: Buffer;

  constructor(masterKeyWrappingHex32Bytes: string) {
    const buf = Buffer.from(masterKeyWrappingHex32Bytes, 'hex');
    if (buf.byteLength !== 32) {
      throw new Error(
        'VAULT_INVALID_KEK_LENGTH: کلید اصلی رمزنگاری (KEK) باید دقیقاً ۳۲ بایت (۶۴ کاراکتر Hex) باشد.'
      );
    }
    this.masterKekBytes = buf;
  }

  /**
   * ۱. رمزنگاری باینری مدل ONNX با الگوی Envelope Encryption (AES-256-GCM)
   * ساختار بسته خروجی:
   * [0..3]: "EMV1"
   * [4..15]: KEK IV (12 bytes)
   * [16..31]: KEK AuthTag (16 bytes)
   * [32..63]: Wrapped DEK (32 bytes)
   * [64..75]: Payload IV (12 bytes)
   * [76..91]: Payload AuthTag (16 bytes)
   * [92..End]: Encrypted ONNX Model Ciphertext
   */
  public encryptModelBytes(
    plaintextOnnxBytes: Uint8Array,
    modelId: string,
    version: string
  ): Uint8Array {
    const aadContext = Buffer.from(`${modelId}:${version}`, 'utf8');

    // الف) تولید کلید تصادفی یکتا برای این نسخه از مدل (DEK)
    const dek = crypto.randomBytes(32);

    // ب) رمزنگاری بدنه مدل با DEK همراه با احراز اصالت AAD
    const payloadIv = crypto.randomBytes(12);
    const payloadCipher = crypto.createCipheriv('aes-256-gcm', dek, payloadIv);
    payloadCipher.setAAD(aadContext);
    const encryptedPayload = Buffer.concat([
      payloadCipher.update(plaintextOnnxBytes),
      payloadCipher.final(),
    ]);
    const payloadAuthTag = payloadCipher.getAuthTag();

    // ج) پیچیدن (Wrap) کلید DEK با کلید اصلی سرور (Master KEK)
    const kekIv = crypto.randomBytes(12);
    const kekCipher = crypto.createCipheriv('aes-256-gcm', this.masterKekBytes, kekIv);
    kekCipher.setAAD(aadContext);
    const wrappedDek = Buffer.concat([kekCipher.update(dek), kekCipher.final()]);
    const kekAuthTag = kekCipher.getAuthTag();

    // پاک‌سازی کلید موقت DEK از حافظه بلافاصله پس از رمزنگاری
    dek.fill(0);

    return Buffer.concat([
      ServerSideEncryptedModelVault.MAGIC,
      kekIv,
      kekAuthTag,
      wrappedDek,
      payloadIv,
      payloadAuthTag,
      encryptedPayload,
    ]);
  }

  /**
   * ۲. رمزگشایی مستقیم در حافظه (بدون نوشتن فایل موقت رمزگشایی‌شده روی دیسک)
   * هرگونه دستکاری در بایت‌ها، تگ اصالت، یا جابه‌جایی نسخه مدل فوراً شناسایی و مسدود می‌شود
   */
  public decryptModelBytesInMemory(
    encryptedEnvelope: Uint8Array,
    expectedModelId: string,
    expectedVersion: string
  ): Uint8Array {
    const buf = Buffer.isBuffer(encryptedEnvelope)
      ? encryptedEnvelope
      : Buffer.from(encryptedEnvelope.buffer, encryptedEnvelope.byteOffset, encryptedEnvelope.byteLength);

    if (buf.byteLength < 92 || !buf.subarray(0, 4).equals(ServerSideEncryptedModelVault.MAGIC)) {
      throw new Error('VAULT_INVALID_MAGIC_FORMAT: هدر بسته رمزنگاری‌شده مدل معتبر نیست.');
    }

    const aadContext = Buffer.from(`${expectedModelId}:${expectedVersion}`, 'utf8');

    const kekIv = buf.subarray(4, 16);
    const kekAuthTag = buf.subarray(16, 32);
    const wrappedDek = buf.subarray(32, 64);
    const payloadIv = buf.subarray(64, 76);
    const payloadAuthTag = buf.subarray(76, 92);
    const ciphertext = buf.subarray(92);

    // الف) باز کردن (Unwrap) کلید DEK
    const kekDecipher = crypto.createDecipheriv('aes-256-gcm', this.masterKekBytes, kekIv);
    kekDecipher.setAAD(aadContext);
    kekDecipher.setAuthTag(kekAuthTag);
    const dek = Buffer.concat([kekDecipher.update(wrappedDek), kekDecipher.final()]);

    try {
      // ب) رمزگشایی وزن‌های مدل با بررسی AuthTag و AAD
      const payloadDecipher = crypto.createDecipheriv('aes-256-gcm', dek, payloadIv);
      payloadDecipher.setAAD(aadContext);
      payloadDecipher.setAuthTag(payloadAuthTag);
      return Buffer.concat([payloadDecipher.update(ciphertext), payloadDecipher.final()]);
    } finally {
      dek.fill(0);
    }
  }
}

بخش صد‌وپنجاه‌وچهارم: تحلیل‌گر تفکیکی خطاهای WER / CER (DetailedAsrErrorBreakdownEvaluator.ts) و تست‌های Vitest

۱. محاسبه‌گر تفکیکی Hits / Substitutions / Deletions / Insertions / CER (DetailedAsrErrorBreakdownEvaluator.ts)

در ارزیابی مدل‌های تشخیص گفتار فارسی، دانستن یک عدد کلی (مثلاً WER = 12%) برای
بهبود مدل کافی نیست! تیم هوش مصنوعی باید بداند این ۱۲ درصد خطا ناشی از حذف کلمات
کوتاه (Deletions مثل «به»، «از»، «را») است، یا تولید کلمات اضافی روی نویز
(Insertions) و یا جاافتادن نیم‌فاصله (Substitutions با CER پایین). این کلاس تمام
این شاخص‌ها را به صورت دقیق محاسبه می‌کند:

// packages/ai-engine/src/evaluation/DetailedAsrErrorBreakdownEvaluator.ts
import { PersianTextNormalizer } from '../PersianTextNormalizer';

export interface AsrErrorBreakdownReport {
  readonly referenceWordCount: number;
  readonly hypothesisWordCount: number;
  readonly hits: number;
  readonly substitutions: number;
  readonly deletions: number;
  readonly insertions: number;
  readonly werPercent: number;
  readonly cerPercent: number;
  readonly topWordSubstitutions: { expected: string; predicted: string; count: number }[];
}

export class DetailedAsrErrorBreakdownEvaluator {
  /**
   * محاسبه کامل خطای کلمه (WER با تفکیک S/D/I) و خطای کاراکتر (CER) روی متن نرمال‌شده فارسی
   */
  public static evaluateDetailedBreakdown(
    referenceText: string,
    hypothesisText: string,
    normalizeBeforeCompare: boolean = true
  ): AsrErrorBreakdownReport {
    const prep = (txt: string) =>
      (normalizeBeforeCompare ? PersianTextNormalizer.normalizeTokenText(txt) : txt)
        .replace(/[،؛.!؟«»"()\-:]/g, ' ')
        .trim();

    const refClean = prep(referenceText);
    const hypClean = prep(hypothesisText);

    const refWords = refClean.split(/\s+/).filter(Boolean);
    const hypWords = hypClean.split(/\s+/).filter(Boolean);

    const wordAlign = this.computeLevenshteinBreakdown(refWords, hypWords);

    // شمارش پرتکرارترین جفت‌های جایگزینی اشتباه (Substitutions) برای ساخت قوانین ماتریس ابهام
    const subPairs = new Map<string, number>();
    for (const pair of wordAlign.substitutionPairs) {
      const key = `${pair.expected}\t${pair.predicted}`;
      subPairs.set(key, (subPairs.get(key) ?? 0) + 1);
    }

    const topWordSubstitutions = Array.from(subPairs.entries())
      .map(([k, count]) => {
        const [expected, predicted] = k.split('\t');
        return { expected, predicted, count };
      })
      .sort((a, b) => b.count - a.count)
      .slice(0, 15);

    // محاسبه Character Error Rate (CER) برای سنجش خطاهای املایی/نیم‌فاصله‌ای فارسی
    const refChars = Array.from(refClean.replace(/\s+/g, ' '));
    const hypChars = Array.from(hypClean.replace(/\s+/g, ' '));
    const charAlign = this.computeLevenshteinBreakdown(refChars, hypChars);

    const werPercent =
      refWords.length > 0
        ? ((wordAlign.substitutions + wordAlign.deletions + wordAlign.insertions) /
            refWords.length) *
          100
        : hypWords.length === 0
        ? 0
        : 100;

    const cerPercent =
      refChars.length > 0
        ? ((charAlign.substitutions + charAlign.deletions + charAlign.insertions) /
            refChars.length) *
          100
        : hypChars.length === 0
        ? 0
        : 100;

    return {
      referenceWordCount: refWords.length,
      hypothesisWordCount: hypWords.length,
      hits: wordAlign.hits,
      substitutions: wordAlign.substitutions,
      deletions: wordAlign.deletions,
      insertions: wordAlign.insertions,
      werPercent: Number(werPercent.toFixed(2)),
      cerPercent: Number(cerPercent.toFixed(2)),
      topWordSubstitutions,
    };
  }

  private static computeLevenshteinBreakdown(
    ref: string[],
    hyp: string[]
  ): {
    hits: number;
    substitutions: number;
    deletions: number;
    insertions: number;
    substitutionPairs: { expected: string; predicted: string }[];
  } {
    const n = ref.length;
    const m = hyp.length;
    const dp = Array.from({ length: n + 1 }, () => new Int32Array(m + 1));
    // 0 = match/sub, 1 = deletion, 2 = insertion
    const ops = Array.from({ length: n + 1 }, () => new Uint8Array(m + 1));

    for (let i = 1; i <= n; i++) {
      dp[i][0] = i;
      ops[i][0] = 1;
    }
    for (let j = 1; j <= m; j++) {
      dp[0][j] = j;
      ops[0][j] = 2;
    }

    for (let i = 1; i <= n; i++) {
      for (let j = 1; j <= m; j++) {
        const isMatch = ref[i - 1] === hyp[j - 1];
        const subCost = dp[i - 1][j - 1] + (isMatch ? 0 : 1);
        const delCost = dp[i - 1][j] + 1;
        const insCost = dp[i][j - 1] + 1;

        if (subCost <= delCost && subCost <= insCost) {
          dp[i][j] = subCost;
          ops[i][j] = 0;
        } else if (delCost <= insCost) {
          dp[i][j] = delCost;
          ops[i][j] = 1;
        } else {
          dp[i][j] = insCost;
          ops[i][j] = 2;
        }
      }
    }

    let hits = 0;
    let substitutions = 0;
    let deletions = 0;
    let insertions = 0;
    const substitutionPairs: { expected: string; predicted: string }[] = [];

    let i = n;
    let j = m;
    while (i > 0 || j > 0) {
      const op = ops[i][j];
      if (i > 0 && j > 0 && op === 0) {
        if (ref[i - 1] === hyp[j - 1]) {
          hits++;
        } else {
          substitutions++;
          substitutionPairs.push({ expected: ref[i - 1], predicted: hyp[j - 1] });
        }
        i--;
        j--;
      } else if (i > 0 && (j === 0 || op === 1)) {
        deletions++;
        i--;
      } else {
        insertions++;
        j--;
      }
    }

    return { hits, substitutions, deletions, insertions, substitutionPairs };
  }
}

