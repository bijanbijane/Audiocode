## قرارداد Transcript

تمام تایم‌کدهای مرجع باید بر اساس Sample Position صحیح باشند.

ساختار هدف:

```typescript
export interface TranscriptToken {
  tokenId: string;
  text: string;
  normalizedText: string;

  startSample: number;
  endSample: number;
  sampleRate: number;

  speakerId?: string;

  timestampGranularity:
    | 'WORD'
    | 'SEGMENT';

  confidence?: number;
}

export interface TranscriptDocument {
  schemaVersion: 'avp.transcript.v1';

  sourceAudioHash: string;
  sampleRate: number;
  totalSamples: number;

  language: 'fa' | 'fa-en' | 'en' | 'auto';

  timestampGranularity:
    | 'WORD'
    | 'SEGMENT';

  tokens: TranscriptToken[];
}
