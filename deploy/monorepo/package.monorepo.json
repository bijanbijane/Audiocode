{
  "name": "persian-ai-audio-platform",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build:wasm": "wasm-pack build packages/wasm-audio-core --target web --out-dir ../audio-runtime/src/wasm-pkg --release",
    "build:contracts": "pnpm --filter @paudio/contracts build",
    "build:web": "pnpm run build:wasm && pnpm run build:contracts && pnpm --filter @paudio/web-studio build",
    "dev:web": "pnpm --filter @paudio/web-studio dev",
    "dev:backend": "pnpm --filter @paudio/platform-backend dev",
    "test:quality-gates": "tsx --test src/quality-gate/AutomatedQualityGateRunner.test.ts",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.21.0",
    "wasm-pack": "^0.13.1"
  }
}
