# deploy/Dockerfile.control-plane — Canonical Full-Stack Control+Data Plane Container (Express + Vite + FFmpeg)
FROM node:22-bookworm-slim AS builder
WORKDIR /workspace

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY tsconfig.json vite.config.ts index.html metadata.json server.ts ./
COPY src ./src
COPY packages ./packages
COPY backend ./backend
COPY platform/migrations ./platform/migrations
COPY public ./public

RUN npm run lint && npm run build \
 && npx esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs

FROM node:22-bookworm-slim AS production
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY package.json ./
COPY --from=builder /workspace/dist ./dist
COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/platform/migrations ./platform/migrations
COPY --from=builder /workspace/public ./public

ENV NODE_ENV=production
ENV PORT=3000

RUN useradd -r -u 1001 -m paudio && chown -R paudio:paudio /app
USER paudio

EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/v1/asr/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "dist/server.mjs"]
