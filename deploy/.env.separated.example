# Copy this file to deploy/.env.separated and replace every placeholder.
# Keep the resulting file secret; never commit a populated .env file.

WEB_PORT=8080
LOCAL_API_PORT=3000

# PostgreSQL credentials. Use a URL-encoded password in PLATFORM_DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
PLATFORM_DATABASE_URL=postgresql://paudio_app:replace-with-a-long-random-password@postgres:5432/paudio_platform

# Legacy Express license signer: preserve the currently deployed key pair exactly.
# Single-quoted values may span multiple lines; paste the real PEM bytes between the markers.
LOCAL_ED25519_PRIVATE_KEY_PEM='-----BEGIN PRIVATE KEY-----
REPLACE_WITH_EXISTING_LOCAL_PRIVATE_KEY_BODY
-----END PRIVATE KEY-----'
LOCAL_ED25519_PUBLIC_KEY_PEM='-----BEGIN PUBLIC KEY-----
REPLACE_WITH_EXISTING_LOCAL_PUBLIC_KEY_BODY
-----END PUBLIC KEY-----'

# New Platform API signer: use a DIFFERENT key pair while routes are isolated under /platform-api.
# Do not replace the legacy Express key until client envelope and offline entitlement parity is proven.
PLATFORM_ED25519_PRIVATE_KEY_PEM='-----BEGIN PRIVATE KEY-----
REPLACE_WITH_NEW_PLATFORM_PRIVATE_KEY_BODY
-----END PRIVATE KEY-----'
PLATFORM_ED25519_PUBLIC_KEY_PEM='-----BEGIN PUBLIC KEY-----
REPLACE_WITH_NEW_PLATFORM_PUBLIC_KEY_BODY
-----END PUBLIC KEY-----'
PLATFORM_ED25519_KEY_ID=platform_ed25519_v1

PAYMENT_WEBHOOK_HMAC_SECRET=replace-with-a-long-random-webhook-secret
ADMIN_API_SECRET_KEY=replace-with-a-long-random-admin-secret
PUBLIC_CDN_BASE_URL=http://localhost:8080/platform-api
