 }\n  html[data-font-scale=\"md\"] {\n    --avp-transcript-size: 16px;\n    --avp-transcript-lh: 2.1;\n  }\n  html[data-font-scale=\"lg\"] {\n    --avp-transcript-size: 18px;\n    --avp-transcript-lh: 2.15;\n  }\n  html.avp-high-contrast {\n    --avp-border: #66727E;\n    --avp-text-secondary: #2B3742;\n  }\n  html.dark.avp-high-contrast {\n    --avp-border: #7B8A97;\n    --avp-text-secondary: #D3DCE6;\n  }\n  html {\n    font-family: var(--font-sans);\n    background-color: var(--avp-bg);\n    color: var(--avp-text);\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n  }\n  body {\n    overflow-x: hidden;\n  }\n  .font-mono {\n    font-family: var(--font-mono);\n    font-variant-numeric: tabular-nums;\n  }\n  .tabular-nums {\n    font-variant-numeric: tabular-nums;\n  }\n  button, a, input, select, textarea {\n    transition-property: color, background-color, border-color, opacity, box-shadow;\n    transition-duration: 140ms;\n    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);\n  }\n  button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, [tabindex]:focus-visible {\n    outline: 2px solid var(--avp-accent);\n    outline-offset: 2px;\n  }\n}\n@layer components {\n  .avp-pane {\n    background-color: var(--avp-surface);\n  }\n  .avp-pane-shell {\n    background-color: var(--avp-surface-shell);\n  }\n  .avp-panel {\n    background-color: var(--avp-surface);\n    border: 1px solid var(--avp-border);\n    border-radius: var(--avp-radius-xl);\n    box-shadow: var(--avp-shadow-sm);\n  }\n  .avp-divider-v {\n    width: 1px;\n    height: 18px;\n    background-color: var(--avp-border);\n    flex-shrink: 0;\n  }\n  .avp-divider-h {\n    height: 1px;\n    width: 100%;\n    background-color: var(--avp-border);\n  }\n  .avp-split-sash {\n    position: relative;\n    height: 6px;\n    width: 100%;\n    background-color: var(--avp-surface-shell);\n    border-top: 1px solid var(--avp-border);\n    border-bottom: 1px solid var(--avp-border);\n    cursor: row-resize;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    user-select: none;\n    z-index: 20;\n    transition: background-color 140ms ease, border-color 140ms ease;\n  }\n  .avp-split-sash:hover, .avp-split-sash[data-dragging=\"true\"] {\n    background-color: var(--avp-accent-soft);\n    border-color: var(--avp-accent);\n  }\n  .avp-split-sash-pill {\n    width: 36px;\n    height: 2px;\n    border-radius: 9999px;\n    background-color: var(--avp-border-strong);\n    transition: background-color 140ms ease, width 140ms ease;\n  }\n  .avp-split-sash:hover .avp-split-sash-pill, .avp-split-sash[data-dragging=\"true\"] .avp-split-sash-pill {\n    width: 48px;\n    background-color: var(--avp-accent);\n  }\n  .avp-bidi-num {\n    direction: ltr;\n    unicode-bidi: isolate;\n    font-family: var(--font-mono);\n    font-variant-numeric: tabular-nums;\n  }\n  .avp-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    height: var(--avp-ctrl-md);\n    padding: 0 12px;\n    border-radius: var(--avp-radius-md);\n    font-size: 12.5px;\n    font-weight: 500;\n    line-height: 1;\n    white-space: nowrap;\n    flex-shrink: 0;\n    cursor: pointer;\n    user-select: none;\n  }\n  .avp-btn:disabled {\n    opacity: 0.38;\n    cursor: not-allowed;\n    pointer-events: none;\n  }\n  .avp-btn-sm {\n    height: var(--avp-ctrl-sm);\n    padding: 0 9px;\n    border-radius: var(--avp-radius-sm);\n    font-size: 11.5px;\n    gap: 5px;\n  }\n  .avp-btn-lg {\n    height: var(--avp-ctrl-lg);\n    padding: 0 16px;\n    border-radius: var(--avp-radius-lg);\n    font-size: 13px;\n    font-weight: 600;\n    gap: 7px;\n  }\n  .avp-btn-primary {\n    background-color: var(--avp-accent);\n    color: #FFFFFF;\n    font-weight: 600;\n    border: 1px solid transparent;\n    box-shadow: var(--avp-shadow-sm);\n  }\n  .avp-btn-primary:hover:not(:disabled) {\n    background-color: var(--avp-accent-hover);\n  }\n  .avp-btn-tonal {\n    background-color: var(--avp-accent-soft);\n    color: var(--avp-accent-text);\n    font-weight: 600;\n    border: 1px solid transparent;\n  }\n  .avp-btn-tonal:hover:not(:disabled) {\n    filter: brightness(0.96);\n  }\n  html.dark .avp-btn-tonal:hover:not(:disabled) {\n    filter: brightness(1.12);\n  }\n  .avp-btn-ghost {\n    background-color: transparent;\n    color: var(--avp-text-secondary);\n    border: 1px solid transparent;\n  }\n  .avp-btn-ghost:hover:not(:disabled) {\n    background-color: var(--avp-surface-hover);\n    color: var(--avp-text);\n  }\n  .avp-btn-outline {\n    background-color: var(--avp-surface);\n    color: var(--avp-text);\n    border: 1px solid var(--avp-border);\n  }\n  .avp-btn-outline:hover:not(:disabled) {\n    background-color: var(--avp-surface-hover);\n    border-color: var(--avp-border-strong);\n  }\n  .avp-btn-danger {\n    background-color: var(--avp-danger);\n    color: #FFFFFF;\n    font-weight: 600;\n    border: 1px solid transparent;\n  }\n  .avp-btn-danger:hover:not(:disabled) {\n    opacity: 0.92;\n  }\n  .avp-btn-danger-ghost {\n    background-color: transparent;\n    color: var(--avp-text-muted);\n    border: 1px solid transparent;\n  }\n  .avp-btn-danger-ghost:hover:not(:disabled) {\n    background-color: var(--avp-danger-soft);\n    color: var(--avp-danger);\n  }\n  .avp-btn-warning-tonal {\n    background-color: var(--avp-warning-soft);\n    color: var(--avp-warning-text);\n    font-weight: 600;\n    border: 1px solid var(--avp-warning);\n    @supports (color: color-mix(in lab, red, red)) {\n      border: 1px solid color-mix(in srgb, var(--avp-warning) 35%, transparent);\n    }\n  }\n  html.dark .avp-btn-warning-tonal {\n    color: var(--avp-warning-text);\n  }\n  .avp-btn-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: var(--avp-ctrl-md);\n    height: var(-