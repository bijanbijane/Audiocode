# Standalone Platform API. Build context: repository root.
# The dependency lock is intentionally generated by the dedicated CI workflow
# and must be committed before promoting this image to production.
FROM node:22-bookworm-slim AS production
WORKDIR /app

COPY backend/package.json ./package.json
COPY backend/package-lock.json ./package-lock.json
RUN npm ci --omit=dev --no-audit --no-fund

COPY backend/src ./src
COPY backend/db ./db

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4000
ENV ENABLE_CLOUD_ASR=false
ENV MODEL_STORAGE_DIR=/var/lib/paudio/models

RUN useradd -r -u 1002 -m platform-api \
 && mkdir -p /var/lib/paudio/models \
 && chown -R platform-api:platform-api /var/lib/paudio /app
USER platform-api

EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/healthz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "--import", "tsx", "src/main.ts"]
