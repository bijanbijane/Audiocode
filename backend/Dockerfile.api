# API/local-runtime image. The browser application is built and served by deploy/web.
# Build context: repository root.
FROM oven/bun:1 AS api-build
WORKDIR /workspace

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY tsconfig.json vite.config.ts server.ts ./
COPY src ./src
COPY packages ./packages
COPY backend ./backend
COPY platform/migrations ./platform/migrations
COPY docs ./docs

RUN mkdir -p dist \
 && bunx esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs

FROM oven/bun:1 AS api-runtime
WORKDIR /app

COPY package.json ./
COPY --from=api-build /workspace/node_modules ./node_modules
COPY --from=api-build /workspace/dist/server.mjs ./dist/server.mjs
COPY --from=api-build /workspace/src ./src
COPY --from=api-build /workspace/packages ./packages
COPY --from=api-build /workspace/backend ./backend
COPY --from=api-build /workspace/platform/migrations ./platform/migrations
COPY --from=api-build /workspace/docs ./docs

ENV NODE_ENV=production
ENV DISABLE_WEB_HOST=true
ENV ENABLE_CLOUD_ASR=false
ENV PORT=3000

EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:3000/api/v1/asr/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["bun", "dist/server.mjs"]
